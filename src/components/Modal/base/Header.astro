---
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<div class="support-modal__header">
  <div>
    <h4 class="modal-title">{title}</h4>
    <p class="support-modal__intro">{intro}</p>
  </div>
  <button
    class="btn-close"
    type="button"
    aria-label="Close"
    data-bs-dismiss="modal"
  ></button>
</div>

<style>
  .support-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(
      140deg,
      rgba(255, 255, 255, 0.08),
      rgba(255, 255, 255, 0) 65%
    );
    flex-shrink: 0;
  }

  .support-modal__header .modal-title {
    font-weight: 700;
    margin: 0;
  }

  .support-modal__intro {
    margin: 8px 0 0;
    color: rgba(255, 255, 255, 0.72);
    max-width: 520px;
  }

  .support-modal__header .btn-close {
    filter: invert(1);
    opacity: 0.7;
  }

  .support-modal__header .btn-close:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .support-modal__header {
      padding-left: 18px;
      padding-right: 18px;
    }
  }
</style>
