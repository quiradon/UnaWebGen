              <li class="mb-1"><User size={16} class="d-inline me-1" /> {t.premium?.feat?.[11]}</li>
              <li class="mb-1"><Coins size={16} class="d-inline me-1" /> 10 {t.premium?.feat?.[4]}</li>
              <li class="mb-1"><Key size={16} class="d-inline me-1" /> {t.premium?.feat?.[6]} {t.premium?.feat?.[12]}</li>
