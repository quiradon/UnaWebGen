---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getLanguages, loadT } from '@lib/i18n';

export async function getStaticPaths() {
  return getLanguages().map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const t = loadT(lang);
const route = '/tools/weather';
---
<Layout t={t} route={route} title={t.tools?.clima?.pageTitle} desc={t.tools?.clima?.pageDesc}>
  <section class="justify-content-lg-center pt-2 mt-4 mb-4">
    <div class="container">
      <div class="col-12 mb-2">
        <h1 class="display-5 fw-bold text-white mb-3">{t.tools?.clima?.pageTitle}</h1>
        <p class="lead text-secondary">{t.tools?.clima?.pageDesc}</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card">
            <div class="card-body">
              <div class="mb-3">
                <label for="climateType" class="form-label mb-2">{t.tools?.clima?.select}</label>
                <select class="form-select" id="climateType">
                  <option value="random">{t.common?.random}</option>
                  <option value="cold">{t.tools?.clima?.type?.cold}</option>
                  <option value="temperate">{t.tools?.clima?.type?.temperate}</option>
                  <option value="desert">{t.tools?.clima?.type?.desert}</option>
                </select>
              </div>
              <button class="btn btn-primary w-100" id="genWeather">{t.tools?.clima?.button}</button>
              <div id="weatherResult" class="mt-3 text-center" style="display: none;">
                <h3 class="weather-condition mb-3"></h3>
                <div class="intensity mb-2"></div>
                <div class="temperature mb-2"></div>
                <div class="wind-speed"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ climaTranslations: t.tools.clima }} is:inline>
    function generateWeather(type) {
      let temp, weather, wind, intensity;
      switch (type) {
        case 'cold':
          temp = Math.floor(Math.random() * 25) - 20; // -20°C to 5°C
          weather = Math.random() < 0.4 ? 'blizzard' : Math.random() < 0.7 ? 'snow' : Math.random() < 0.9 ? 'cloudy' : 'clear';
          wind = Math.floor(Math.random() * 60) + 10; // 10-70 km/h
          intensity = Math.random() < 0.3 ? 'severe' : Math.random() < 0.7 ? 'moderate' : 'mild';
          break;
        case 'temperate':
          temp = Math.floor(Math.random() * 30) + 0; // 0°C to 30°C
          weather = Math.random() < 0.3 ? 'thunderstorm' : Math.random() < 0.5 ? 'heavy_rain' : Math.random() < 0.7 ? 'light_rain' : Math.random() < 0.85 ? 'cloudy' : 'clear';
          wind = Math.floor(Math.random() * 40) + 5; // 5-45 km/h
          intensity = Math.random() < 0.2 ? 'severe' : Math.random() < 0.6 ? 'moderate' : 'mild';
          break;
        case 'desert':
          temp = Math.floor(Math.random() * 35) + 15; // 15°C to 50°C
          weather = Math.random() < 0.6 ? 'clear' : Math.random() < 0.8 ? 'sandstorm' : Math.random() < 0.9 ? 'dust_devil' : 'cloudy';
          wind = Math.floor(Math.random() * 50) + 15; // 15-65 km/h
          intensity = Math.random() < 0.3 ? 'severe' : Math.random() < 0.7 ? 'moderate' : 'mild';
          break;
        default:
          const types = ['cold', 'temperate', 'desert'];
          return generateWeather(types[Math.floor(Math.random() * types.length)]);
      }
      return { temp, weather, wind, intensity };
    }
    const T = {
      options: climaTranslations.options || {},
      intense: climaTranslations.intense || {},
      temperatura: climaTranslations.temperatura || 'Temperatura',
      vento: climaTranslations.vento || 'Velocidade do vento'
    };
    document.getElementById('genWeather').addEventListener('click', function() {
      const type = document.getElementById('climateType').value;
      const result = generateWeather(type);
      const weatherResult = document.getElementById('weatherResult');
      const translations = T.options || {};
      const intensityTranslations = T.intense || {};
      weatherResult.style.display = 'block';
      weatherResult.querySelector('.weather-condition').textContent = translations[result.weather] || '';
      weatherResult.querySelector('.intensity').textContent = intensityTranslations[result.intensity] || '';
      weatherResult.querySelector('.temperature').textContent = `${T.temperatura}: ${result.temp}°C`;
      weatherResult.querySelector('.wind-speed').textContent = `${T.vento} ${result.wind} km/h`;
    });
  </script>
</Layout>
