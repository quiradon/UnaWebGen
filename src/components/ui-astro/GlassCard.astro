---
interface Props {
  as?: "div" | "a" | "section" | "article";
  href?: string;
  class?: string;
  [key: string]: any;
}

const { as = "div", href, class: className, ...rest } = Astro.props;
const Tag = as;

const baseClass = "kr-glass-card";
const classes = className ? `${baseClass} ${className}` : baseClass;
---

<Tag {...(as === "a" ? { href, ...rest } : rest)} class={classes}>
  <slot />
</Tag>

<style is:global>
  .kr-glass-card {
    background: rgba(29, 26, 45, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
</style>
