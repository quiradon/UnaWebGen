---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT } from '@lib/i18n';

const t = loadT('en');
const route = '/tools/coinflip';
---
<Layout t={t} route={route} title={t.flip_coin?.title} desc={t.flip_coin?.description}>
  <section class="justify-content-lg-center pt-2 mt-3 mb-4">
    <div class="container align-items-center">
      <div class="text-white">
        <h1 class="fw-bold text-white mb-3">{t.flip_coin?.title}</h1>
        <p class="mb-4 text-secondary">{t.flip_coin?.desc}</p>
      </div>

      <div id="coins-container" class="d-flex flex-wrap justify-content-center gap-2">
        <div class="coin" onclick="flipCoin(this)">
          <div class="side front"></div>
          <div class="side back"></div>
        </div>
      </div>
      <div class="button-container mt-3">
        <button class="btn btn-primary" onclick="rerollAll()">{t.flip_coin?.btn}</button>
      </div>
      <div class="button-container stack-controls mt-3">
        <button class="btn btn-secondary" onclick="decreaseStack()">-</button>
        <input type="number" disabled id="stack-size" class="form-control d-inline-block w-auto" value="1" min="1" max="24" onchange="setStackSize()" />
        <button class="btn btn-secondary" onclick="increaseStack()">+</button>
      </div>
    </div>
  </section>

  <style is:global>
    .coin { width: 120px; height: 120px; perspective: 1000px; cursor: pointer; }
    .coin .side { width: 100%; height: 100%; position: absolute; backface-visibility: hidden; border-radius: 50%; border: 3px solid var(--bs-primary); }
    .coin .front { background: radial-gradient(circle, #ffd700, #b8860b); }
    .coin .back { background: radial-gradient(circle, #e0e0e0, #a9a9a9); transform: rotateY(180deg); }
  </style>

  <script is:inline>
    const container = document.getElementById('coins-container');
    function flipCoin(el) {
      el.style.transition = 'transform 1s';
      el.style.transform = `rotateY(${Math.random() > 0.5 ? 180 : 360}deg)`;
      setTimeout(() => { el.style.transform = 'rotateY(0deg)'; }, 1050);
    }
    function rerollAll() { document.querySelectorAll('.coin').forEach((c) => flipCoin(c)); }
    function increaseStack() { const input = document.getElementById('stack-size'); const v = Math.min(24, parseInt(input.value) + 1); input.value = v; render(); }
    function decreaseStack() { const input = document.getElementById('stack-size'); const v = Math.max(1, parseInt(input.value) - 1); input.value = v; render(); }
    function setStackSize() { render(); }
    function render() {
      const i = document.getElementById('stack-size');
      const size = parseInt(i.value);
      container.innerHTML = '';
      for (let k = 0; k < size; k++) {
        const div = document.createElement('div');
        div.className = 'coin';
        div.innerHTML = '<div class="side front"></div><div class="side back"></div>';
        div.onclick = () => flipCoin(div);
        container.appendChild(div);
      }
    }
    render();
  </script>
</Layout>

