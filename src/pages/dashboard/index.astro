---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import { getLocale } from "astro-i18n-aut";
import { loadT, getStaticPaths } from "@lib/i18n";
import { idiomaR } from "@lib/routes";
import config from "../../config";
import DashboardContent from "@components/dashboard/DashboardContent.astro";

export { getStaticPaths };

const Locale = getLocale(Astro.url);
const t = loadT(Locale);
const langPrefix = idiomaR(t);
const apiBase = (config.api_url ?? "https://api-rpg.arkanus.app").replace(
  /\/$/,
  "",
);
---

<Layout t={t} title="Dashboard">
  <div
    style="display: none;"
    data-api-base={apiBase}
    data-lang-prefix={langPrefix}
  >
  </div>

  <DashboardContent t={t} langPrefix={langPrefix} />

  <script>
    import {
      getSessionCachedFirst,
      revalidateSession,
      clearSessionCache,
    } from "../../scripts/session-manager";

    function setUserCardLoading(isLoading: boolean) {
      const userCard = document.getElementById("user-profile-card");
      if (!userCard) return;
      userCard.setAttribute("data-loading", isLoading ? "true" : "false");
      userCard.setAttribute("aria-busy", isLoading ? "true" : "false");
    }

    function applyUser(sessionData: any) {
      if (!sessionData?.user) return;
      const user = sessionData.user;

      const avatarImg = document.getElementById(
        "user-avatar",
      ) as HTMLImageElement | null;
      const displayNameEl = document.getElementById("user-display-name");
      const usernameEl = document.getElementById("user-username");
      const userIdEl = document.getElementById("user-id");

      if (avatarImg) {
        avatarImg.src = user.avatar_url || "";
        avatarImg.alt = user.display_name || "User Avatar";
      }

      const premiumBadge = document.getElementById(
        "premium-badge",
      ) as HTMLImageElement | null;
      if (
        premiumBadge &&
        sessionData.premium &&
        sessionData.premium.level >= 1 &&
        sessionData.premium.active
      ) {
        const level = Math.min(Math.max(sessionData.premium.level, 1), 4);
        premiumBadge.src = `/img/tiers_premium/${level}.webp`;
        premiumBadge.classList.add("active");
      } else if (premiumBadge) {
        premiumBadge.classList.remove("active");
      }

      const displayName = user.display_name || user.username || "Discord User";
      const username = user.username || "unknown";

      if (displayNameEl) displayNameEl.textContent = displayName;

      const usernameDisplayEl = document.getElementById(
        "user-username-display",
      );
      if (usernameDisplayEl) usernameDisplayEl.textContent = "@" + username;

      if (usernameEl) usernameEl.textContent = username;
      if (userIdEl) userIdEl.textContent = user.id || "-";
    }

    async function initDashboard() {
      const apiBaseEl = document.querySelector(
        "[data-api-base]",
      ) as HTMLElement | null;
      const langPrefixEl = document.querySelector(
        "[data-lang-prefix]",
      ) as HTMLElement | null;
      const apiBase = apiBaseEl?.dataset.apiBase || "";
      const langPrefix = langPrefixEl?.dataset.langPrefix || "";

      setUserCardLoading(true);

      try {
        const sessionData = await getSessionCachedFirst(apiBase);
        if (!sessionData.authenticated || !sessionData.user) {
          window.location.href = langPrefix || "/";
          return;
        }

        applyUser(sessionData);
        setUserCardLoading(false);

        revalidateSession(apiBase).then((fresh) => {
          if (!fresh?.authenticated || !fresh.user) return;
          applyUser(fresh);
        });
      } catch (error) {
        console.error("Failed to load dashboard:", error);
        window.location.href = langPrefix || "/";
      }
    }

    function setupLogoutHandler() {
      const logoutBtn = document.getElementById("logout-btn");
      if (logoutBtn && !(logoutBtn as any).__logoutHandlerAttached) {
        (logoutBtn as any).__logoutHandlerAttached = true;

        const apiBaseEl = document.querySelector(
          "[data-api-base]",
        ) as HTMLElement | null;
        const langPrefixEl = document.querySelector(
          "[data-lang-prefix]",
        ) as HTMLElement | null;
        const apiBase = apiBaseEl?.dataset.apiBase || "";
        const langPrefix = langPrefixEl?.dataset.langPrefix || "";

        logoutBtn.addEventListener("click", async () => {
          try {
            await fetch(`${apiBase}/auth/logout`, {
              method: "POST",
              credentials: "include",
            });

            clearSessionCache();
            window.location.href = langPrefix || "/";
          } catch (error) {
            console.error("Failed to logout", error);
            window.location.href = langPrefix || "/";
          }
        });
      }
    }

    initDashboard();
    setupLogoutHandler();

    document.addEventListener("astro:page-load", () => {
      if (window.location.pathname.includes("/dashboard")) {
        initDashboard();
        setupLogoutHandler();
      }
    });
  </script>
</Layout>

