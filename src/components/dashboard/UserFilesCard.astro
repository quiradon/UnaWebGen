---
import { FileIcon, Download, Eye, HardDrive } from "@lucide/astro";
import GlassCard from "@components/ui-astro/GlassCard.astro";

interface Props {
  t: any;
  apiBase?: string;
}

const { t, apiBase = "" } = Astro.props;
---

<GlassCard class="user-files-card h-100 p-4" data-api-base={apiBase}>
  <div class="d-flex align-items-center gap-2 mb-4">
    <HardDrive size={24} class="text-primary" />
    <h5 class="mb-0 text-white">{t.Dashbaord.files.title}</h5>
  </div>

  <div class="files-content">
    <!-- Loading State -->
    <div id="files-loading" class="text-center py-4" style="display: block;">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">{t.Dashbaord.files.loading}</span>
      </div>
      <p class="mt-3 text-muted">{t.Dashbaord.files.loading}</p>
    </div>

    <!-- Error State -->
    <div id="files-error" class="text-center py-4" style="display: none;">
      <p class="text-danger">{t.Dashbaord.files.error}</p>
      <button id="retry-files-btn" class="btn btn-sm btn-outline-primary mt-2">
        Tentar novamente
      </button>
    </div>

    <!-- Empty State -->
    <div id="files-empty" class="text-center py-4" style="display: none;">
      <FileIcon size={48} class="text-muted mb-3" />
      <p class="text-muted">{t.Dashbaord.files.empty}</p>
    </div>

    <!-- Files List -->
    <div id="files-list" style="display: none;">
      <!-- Stats -->
      <div class="files-stats mb-4 p-3 bg-dark rounded">
        <div class="row g-2">
          <div class="col-6">
            <small class="text-muted d-block">Total de arquivos</small>
            <strong id="total-files-count">0</strong>
          </div>
          <div class="col-6">
            <small class="text-muted d-block">{t.Dashbaord.files.total_size}</small>
            <strong id="total-files-size">0 KB</strong>
          </div>
        </div>
      </div>

      <!-- Gallery Grid -->
      <div id="files-gallery" class="files-gallery">
        <!-- Files will be inserted here -->
      </div>

      <!-- Pagination -->
      <div id="files-pagination" class="files-pagination mt-4" style="display: none;">
        <div class="pagination-info">
          <span id="pagination-info-text">Página 1 de 1</span>
        </div>
        <div class="pagination-controls">
          <button id="pagination-prev" class="btn btn-sm btn-primary" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            Anterior
          </button>
          <div id="pagination-pages" class="pagination-pages">
            <!-- Page buttons will be inserted here -->
          </div>
          <button id="pagination-next" class="btn btn-sm btn-primary">
            Próxima
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</GlassCard>

<style is:global>
  .user-files-card {
    min-height: 400px;
  }

  .user-files-card .files-content {
    min-height: 300px;
  }

  .user-files-card .files-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .user-files-card .gallery-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .user-files-card .gallery-item:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    border-color: var(--bs-primary);
  }

  .user-files-card .gallery-image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: rgba(0, 0, 0, 0.2);
    overflow: hidden;
    z-index: 1;
  }

  .user-files-card .gallery-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .user-files-card .gallery-item:hover .gallery-image {
    transform: scale(1.05);
  }

  .user-files-card .gallery-info-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.75rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.6) 60%, transparent 100%);
    transition: opacity 0.3s ease;
    z-index: 20;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    opacity: 0;
    pointer-events: none;
    height: 100%;
    pointer-events: none;
    max-height: 80px;
  }

  .user-files-card .gallery-item:hover .gallery-info-overlay {
    opacity: 1;
  }

  .user-files-card .gallery-actions {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    bottom: auto;
    display: flex;
    gap: 0.25rem;
    opacity: 0;
    transform: translateY(-8px);
    transition: all 0.3s ease;
    z-index: 20;
  }

  .user-files-card .gallery-item:hover .gallery-actions {
    opacity: 1;
    transform: translateY(0);
  }

  .user-files-card .gallery-action-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: white;
    text-decoration: none;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .user-files-card .gallery-action-btn:hover {
    background: var(--bs-primary);
    border-color: var(--bs-primary);
    color: white;
    transform: scale(1.15);
    box-shadow: 0 4px 12px rgba(var(--bs-primary-rgb), 0.4);
  }

  .user-files-card .gallery-action-btn.gallery-action-delete {
    border-color: rgba(220, 53, 69, 0.35);
  }

  .user-files-card .gallery-action-btn.gallery-action-delete:hover {
    background: #dc3545;
    border-color: #dc3545;
    color: white;
    box-shadow: 0 4px 12px rgba(220, 53, 69, 0.4);
  }

  .user-files-card .files-stats {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.3) !important;
  }

  .user-files-card .files-stats strong {
    color: white;
    font-size: 1.25rem;
  }

  /* Overlay gradient on hover */
  .user-files-card .gallery-item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.3) 0%,
      transparent 40%
    );
    opacity: 1;
    transition: opacity 0.3s ease;
    z-index: 1;
    pointer-events: none;
  }

  .user-files-card .gallery-item:hover::before {
    opacity: 1;
  }

  .user-files-card .gallery-info {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .user-files-card .files-gallery {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0.75rem;
    }

    .user-files-card .gallery-info {
      padding: 0.5rem;
    }

    .user-files-card .gallery-filename {
      font-size: 0.8rem;
    }

    .user-files-card .gallery-meta {
      font-size: 0.7rem;
    }

    .user-files-card .gallery-action-btn {
      width: 32px;
      height: 32px;
    }
  }

  @media (max-width: 576px) {
    .user-files-card .files-gallery {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }
  }

  /* Pagination Styles */
  .user-files-card .files-pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .user-files-card .pagination-info {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
  }

  .user-files-card .pagination-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .user-files-card .pagination-controls .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .user-files-card .pagination-pages {
    display: flex;
    gap: 0.25rem;
  }

  .user-files-card .pagination-page-btn {
    min-width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .user-files-card .pagination-page-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--bs-primary);
  }

  .user-files-card .pagination-page-btn.active {
    background: var(--bs-primary);
    border-color: var(--bs-primary);
    color: white;
  }

  .user-files-card .pagination-page-btn.ellipsis {
    cursor: default;
    background: transparent;
    border-color: transparent;
  }

  .user-files-card .pagination-page-btn.ellipsis:hover {
    background: transparent;
    border-color: transparent;
  }

  @media (max-width: 576px) {
    .user-files-card .pagination-controls {
      width: 100%;
    }

    .user-files-card .pagination-controls .btn {
      flex: 1;
    }

    .user-files-card .pagination-pages {
      display: none;
    }
  }
</style>

<script>
  interface FileData {
    id: number;
    size: number;
    type: number;
    path: string;
    url: string;
  }

  interface PaginationData {
    page: number;
    limit: number;
    total_files: number;
    total_pages: number;
    has_next: boolean;
    has_prev: boolean;
  }

  interface FilesResponse {
    success: boolean;
    files: FileData[];
    pagination: PaginationData;
    total_size: number;
  }

  // State
  let currentPage = 1;
  let currentFiles: FileData[] = [];
  let pendingDeleteFile: FileData | null = null;
  let deleteModalInstance: any | null = null;

  async function downloadFile(url: string, filename: string) {
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error('Network response was not ok');
      const blob = await response.blob();
      const blobUrl = window.URL.createObjectURL(blob);
      
      const a = document.createElement('a');
      a.style.display = 'none';
      a.href = blobUrl;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      
      window.URL.revokeObjectURL(blobUrl);
      document.body.removeChild(a);
    } catch (error) {
      console.error('Download failed:', error);
      // Fallback
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.target = '_blank';
      a.click();
    }
  }

  function formatBytes(bytes: number): string {
    if (bytes === 0) return "0 Bytes";
    const k = 1024;
    const sizes = ["Bytes", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + " " + sizes[i];
  }

  function getFileType(type: number): string {
    const types: { [key: number]: string } = {
      0: "Geral",
      1: "Imagem",
      2: "Documento",
      3: "Áudio",
      4: "Vídeo",
    };
    return types[type] || "Desconhecido";
  }

  function getFileName(path: string): string {
    const parts = path.split("/");
    return parts[parts.length - 1] || path;
  }

  function generatePaginationButtons(pagination: PaginationData): string {
    const { page, total_pages } = pagination;
    const buttons: string[] = [];
    const maxVisible = 5;
    
    let startPage = Math.max(1, page - Math.floor(maxVisible / 2));
    let endPage = Math.min(total_pages, startPage + maxVisible - 1);
    
    if (endPage - startPage + 1 < maxVisible) {
      startPage = Math.max(1, endPage - maxVisible + 1);
    }

    if (startPage > 1) {
      buttons.push(`<button class="pagination-page-btn" data-page="1">1</button>`);
      if (startPage > 2) {
        buttons.push(`<span class="pagination-page-btn ellipsis">...</span>`);
      }
    }

    for (let i = startPage; i <= endPage; i++) {
      buttons.push(`<button class="pagination-page-btn ${i === page ? 'active' : ''}" data-page="${i}">${i}</button>`);
    }

    if (endPage < total_pages) {
      if (endPage < total_pages - 1) {
        buttons.push(`<span class="pagination-page-btn ellipsis">...</span>`);
      }
      buttons.push(`<button class="pagination-page-btn" data-page="${total_pages}">${total_pages}</button>`);
    }

    return buttons.join('');
  }

  function updatePagination(pagination: PaginationData) {
    const paginationEl = document.getElementById("files-pagination");
    const infoTextEl = document.getElementById("pagination-info-text");
    const prevBtn = document.getElementById("pagination-prev") as HTMLButtonElement;
    const nextBtn = document.getElementById("pagination-next") as HTMLButtonElement;
    const pagesEl = document.getElementById("pagination-pages");

    if (!paginationEl || !infoTextEl || !prevBtn || !nextBtn || !pagesEl) return;

    if (pagination.total_pages <= 1) {
      paginationEl.style.display = "none";
      return;
    }

    paginationEl.style.display = "flex";
    infoTextEl.textContent = `Página ${pagination.page} de ${pagination.total_pages} (${pagination.total_files} arquivos)`;
    
    prevBtn.disabled = !pagination.has_prev;
    nextBtn.disabled = !pagination.has_next;

    pagesEl.innerHTML = generatePaginationButtons(pagination);

    // Add click handlers to page buttons
    pagesEl.querySelectorAll('.pagination-page-btn[data-page]').forEach(btn => {
      btn.addEventListener('click', () => {
        const page = parseInt((btn as HTMLElement).dataset.page || '1');
        loadUserFiles(page);
      });
    });
  }

  function findFileById(fileId: number): FileData | undefined {
    return currentFiles.find((file) => file.id === fileId);
  }

  function openDeleteModal(file: FileData) {
    pendingDeleteFile = file;
    const nameEl = document.getElementById("delete-file-name");
    if (nameEl) {
      nameEl.textContent = getFileName(file.path);
    }

    const errorEl = document.getElementById("delete-file-error");
    if (errorEl) {
      errorEl.style.display = "none";
    }

    const confirmBtn = document.getElementById("delete-file-confirm-btn") as HTMLButtonElement | null;
    if (confirmBtn) {
      confirmBtn.disabled = false;
      confirmBtn.textContent = "Excluir";
    }

    const modalEl = document.getElementById("file_delete_modal");
    const bootstrap = (window as any).bootstrap;
    if (bootstrap && bootstrap.Modal && modalEl) {
      deleteModalInstance = bootstrap.Modal.getOrCreateInstance
        ? bootstrap.Modal.getOrCreateInstance(modalEl)
        : new bootstrap.Modal(modalEl);
      deleteModalInstance.show();
    }
  }

  async function confirmDelete() {
    if (!pendingDeleteFile) return;

    const confirmBtn = document.getElementById("delete-file-confirm-btn") as HTMLButtonElement | null;
    const errorEl = document.getElementById("delete-file-error");

    if (confirmBtn) {
      confirmBtn.disabled = true;
      confirmBtn.textContent = "Excluindo...";
    }

    if (errorEl) {
      errorEl.style.display = "none";
    }

    try {
      const cardEl = document.querySelector(".user-files-card") as HTMLElement | null;
      const apiBase = cardEl?.dataset.apiBase || "";

      if (!apiBase) {
        throw new Error("API base URL not configured");
      }

      const response = await fetch(`${apiBase}/rpg/files/${pendingDeleteFile.id}`, {
        method: "DELETE",
        credentials: "include",
      });

      if (!response.ok) {
        throw new Error("Failed to delete file");
      }

      if (deleteModalInstance) {
        deleteModalInstance.hide();
      }

      const nextPage = currentFiles.length <= 1 && currentPage > 1 ? currentPage - 1 : currentPage;
      pendingDeleteFile = null;
      await loadUserFiles(nextPage);
    } catch (error) {
      console.error("Error deleting file:", error);
      if (errorEl) {
        errorEl.textContent = "Erro ao excluir arquivo";
        errorEl.style.display = "block";
      }
    } finally {
      if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.textContent = "Excluir";
      }
    }
  }

  function setupDeleteModalHandlers() {
    const confirmBtn = document.getElementById("delete-file-confirm-btn") as HTMLButtonElement | null;
    if (confirmBtn && !confirmBtn.dataset.bound) {
      confirmBtn.dataset.bound = "true";
      confirmBtn.addEventListener("click", () => {
        confirmDelete();
      });
    }

    const modalEl = document.getElementById("file_delete_modal");
    if (modalEl && !modalEl.dataset.bound) {
      modalEl.dataset.bound = "true";
      modalEl.addEventListener("hidden.bs.modal", () => {
        pendingDeleteFile = null;
      });
    }
  }

  async function loadUserFiles(page: number = 1) {
    const loadingEl = document.getElementById("files-loading");
    const errorEl = document.getElementById("files-error");
    const emptyEl = document.getElementById("files-empty");
    const listEl = document.getElementById("files-list");

    if (!loadingEl || !errorEl || !emptyEl || !listEl) return;

    // Show loading
    loadingEl.style.display = "block";
    errorEl.style.display = "none";
    emptyEl.style.display = "none";
    listEl.style.display = "none";

    try {
      const cardEl = document.querySelector(".user-files-card") as HTMLElement | null;
      const apiBase = cardEl?.dataset.apiBase || "";

      if (!apiBase) {
        console.error("API base URL not found");
        throw new Error("API base URL not configured");
      }

      const response = await fetch(`${apiBase}/rpg/files?page=${page}&limit=15`, {
        credentials: "include",
      });

      if (!response.ok) {
        throw new Error("Failed to fetch files");
      }

      const data: FilesResponse = await response.json();

      loadingEl.style.display = "none";

      if (data.pagination.total_files === 0) {
        emptyEl.style.display = "block";
        return;
      }

      // Update state
      currentPage = data.pagination.page;
      currentFiles = data.files;

      // Update stats
      const totalFilesEl = document.getElementById("total-files-count");
      const totalSizeEl = document.getElementById("total-files-size");

      if (totalFilesEl) totalFilesEl.textContent = data.pagination.total_files.toString();
      if (totalSizeEl) totalSizeEl.textContent = formatBytes(data.total_size);

      // Render files in gallery
      const gallery = document.getElementById("files-gallery");
      if (gallery) {
        gallery.innerHTML = data.files
          .map(
            (file) => `
          <div class="gallery-item" data-image-url="${file.url}" data-filename="${getFileName(file.path)}" data-file-id="${file.id}">
            <div class="gallery-image-container">
              <img 
                src="${file.url}" 
                alt="${getFileName(file.path)}"
                class="gallery-image"
                loading="lazy"
              />
            </div>
            <div class="gallery-info-overlay">
              <div class="gallery-meta">
                <span>${getFileType(file.type)}</span>
                <span>${formatBytes(file.size)}</span>
              </div>
            </div>
            <div class="gallery-actions" onclick="event.stopPropagation()">
              <button
                type="button"
                class="gallery-action-btn gallery-action-download"
                data-url="${file.url}"
                data-filename="${getFileName(file.path)}"
                title="Baixar"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </button>
              <button
                type="button"
                class="gallery-action-btn gallery-action-delete"
                data-file-id="${file.id}"
                title="Excluir"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>
              </button>
            </div>
          </div>
        `,
          )
          .join("");

        // Add click handlers to gallery items
        const galleryItems = gallery.querySelectorAll(".gallery-item");
        galleryItems.forEach((item) => {
          item.addEventListener("click", () => {
            const imageUrl = (item as HTMLElement).dataset.imageUrl;
            const filename = (item as HTMLElement).dataset.filename;
            const fileId = Number.parseInt((item as HTMLElement).dataset.fileId || "0", 10);
            const file = Number.isFinite(fileId) ? findFileById(fileId) : undefined;
            if (imageUrl && filename && file) {
              // Dispatch custom event to open file preview modal
              window.dispatchEvent(new CustomEvent('openFilePreview', {
                detail: { 
                  url: imageUrl, 
                  filename: filename,
                  type: file.type
                }
              }));
            }
          });
        });

        const deleteButtons = gallery.querySelectorAll(".gallery-action-delete");
        deleteButtons.forEach((button) => {
          button.addEventListener("click", (event) => {
            event.stopPropagation();
            const fileId = Number.parseInt((button as HTMLElement).dataset.fileId || "0", 10);
            if (!Number.isFinite(fileId)) return;
            const file = findFileById(fileId);
            if (file) {
              openDeleteModal(file);
            }
          });
        });

        const downloadButtons = gallery.querySelectorAll(".gallery-action-download");
        downloadButtons.forEach((button) => {
          button.addEventListener("click", (event) => {
            event.stopPropagation();
            const btn = button as HTMLElement;
            const url = btn.dataset.url;
            const filename = btn.dataset.filename;
            if (url && filename) {
              downloadFile(url, filename);
            }
          });
        });
      }

      // Update pagination
      updatePagination(data.pagination);

      listEl.style.display = "block";

      // Scroll to top of gallery on page change
      if (page !== 1) {
        const cardEl = document.querySelector(".user-files-card");
        cardEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } catch (error) {
      console.error("Error loading files:", error);
      loadingEl.style.display = "none";
      errorEl.style.display = "block";
    }
  }

  function setupPaginationListeners() {
    const prevBtn = document.getElementById("pagination-prev");
    const nextBtn = document.getElementById("pagination-next");

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        loadUserFiles(currentPage - 1);
      }
    });

    nextBtn?.addEventListener('click', () => {
      loadUserFiles(currentPage + 1);
    });
  }

  // Load files on page load
  document.addEventListener("DOMContentLoaded", () => {
    loadUserFiles(1);
    setupPaginationListeners();
    setupDeleteModalHandlers();

    // Setup retry button
    const retryBtn = document.getElementById("retry-files-btn");
    if (retryBtn) {
      retryBtn.addEventListener("click", () => {
        loadUserFiles(currentPage);
      });
    }
  });

  // Reload files when navigating with Astro
  document.addEventListener("astro:page-load", () => {
    if (window.location.pathname.includes("/dashboard")) {
      currentPage = 1;
      loadUserFiles(1);
      setupPaginationListeners();
      setupDeleteModalHandlers();

      // Re-setup retry button
      const retryBtn = document.getElementById("retry-files-btn");
      if (retryBtn) {
        retryBtn.addEventListener("click", () => {
          loadUserFiles(currentPage);
        });
      }
    }
  });
</script>
