---
import PremiumPlanCard from "@components/Premium/PlanCard.astro";
import {
  User,
  MessageCircle,
  Key,
  Coins,
  Dices,
  Tags,
  BookText,
  Palette,
  Package,
  Info,
  Crown,
} from "@lucide/astro";
import tier1 from "@assets/img/tiers_premium/1.webp";
import tier2 from "@assets/img/tiers_premium/2.webp";
import tier3 from "@assets/img/tiers_premium/3.webp";
import tier4 from "@assets/img/tiers_premium/4.webp";

const { t } = Astro.props;

const feat = t?.premium?.feat ?? {};
const price = t?.price ?? {};
const coinsLabel = feat?.[4] ?? "Kraken Coins";
const guildsLabel = t?.index?.status?.guilds ?? "Servidores";
const supportLabel = feat?.[5] ?? "Suporte prioritario";
const ctaLabel = t?.index?.donate?.btn ?? "Apoiar Projeto";
const joinText = (...parts: (string | undefined | null)[]): string => parts.filter(Boolean).join(" ");

const price0 = price?.[0] ?? "15R$/mes";
const price1 = price?.[1] ?? "25R$/mes";
const price2 = price?.[2] ?? "30R$/mes";
const price3 = price?.[3] ?? "50R$/mes";

const plans = [
  {
    title: t.v2.premium.tier[0].name,
    desc:
      t?.premium?.[0]?.desc ??
      "Plano para quem joga sozinho e quer recursos basicos.",
    priceMonthly: price0,
    titleIcon: Crown,
    primary: [
      { Icon: User, text: feat?.[10] },
      { Icon: Coins, text: `2 ${coinsLabel}` },
      { Icon: Key, text: joinText(feat?.[6], feat?.[7]) },
      { Icon: MessageCircle, text: supportLabel },
    ],
    secondary: [
      { Icon: Dices, text: feat?.[0] },
      { Icon: Tags, text: feat?.[1] },
      { Icon: BookText, text: feat?.[2] },
    ],
    accent: "#f59e0b",
    badge: tier1,
  },
  {
    title: t.v2.premium.tier[1].name,
    desc:
      t?.premium?.[1]?.desc ??
      "Beneficios para todo o servidor, com mais recursos.",
    priceMonthly: price1,
    titleIcon: User,
    primary: [
      { Icon: User, text: feat?.[10] },
      { Icon: Coins, text: `4 ${coinsLabel}` },
      { Icon: Key, text: joinText(feat?.[6], feat?.[8]) },
      { Icon: MessageCircle, text: supportLabel },
    ],
    secondary: [
      { Icon: Dices, text: feat?.[0] },
      { Icon: Tags, text: feat?.[1] },
      { Icon: BookText, text: feat?.[2] },
      { Icon: Palette, text: feat?.[3] },
    ],
    accent: "#38bdf8",
    badge: tier2,
  },
  {
    title: t.v2.premium.tier[2].name,
    desc: t?.premium?.[2]?.desc ?? "Para quem quer tudo liberado.",
    priceMonthly: price2,
    titleIcon: Crown,
    primary: [
      { Icon: User, text: feat?.[11] },
      { Icon: Coins, text: `10 ${coinsLabel}` },
      { Icon: Key, text: joinText(feat?.[6], feat?.[12]) },
      { Icon: MessageCircle, text: supportLabel },
      { Icon: Package, text: feat?.[9] },
      { Icon: Info, text: feat?.[98] },
      { Icon: Package, text: feat?.[99] },
    ],
    secondary: [
      { Icon: Dices, text: feat?.[0] },
      { Icon: Tags, text: feat?.[1] },
      { Icon: BookText, text: feat?.[2] },
      { Icon: Palette, text: feat?.[3] },
    ],
    accent: "#22c55e",
    badge: tier3,
  },
  {
    title: t.v2.premium.tier[3].name,
    desc:
      t?.premium?.[3]?.desc ??
      "Prioridade maxima para servidores grandes.",
    priceMonthly: price3,
    titleIcon: Crown,
    primary: [
      { Icon: User, text: feat?.[11] },
      { Icon: Coins, text: `20 ${coinsLabel}` },
      { Icon: Key, text: joinText(feat?.[6], `6 ${guildsLabel}`) },
      { Icon: MessageCircle, text: supportLabel },
      { Icon: Package, text: feat?.[9] },
      { Icon: Info, text: feat?.[98] },
      { Icon: Package, text: feat?.[99] },
    ],
    secondary: [
      { Icon: Dices, text: feat?.[0] },
      { Icon: Tags, text: feat?.[1] },
      { Icon: BookText, text: feat?.[2] },
      { Icon: Palette, text: feat?.[3] },
    ],
    accent: "#f97316",
    badge: tier4,
  },
];

---

<section
  id="premium"
  class="d-xl-flex justify-content-xl-center"
  data-premium-plans
>
  <div class="container">
    <div class="row">
      <div class="col mb-3">
        <h2 class="display-4 fw-bold mt-0">{t?.index?.donate?.title}</h2>
        <p class="lead text-secondary mb-5">{t?.index?.donate?.desc}</p>
      </div>
    </div>

    <div class="row g-4 align-items-stretch premium-plans-grid">
      {plans.map((plan) => (
        <PremiumPlanCard
          title={plan.title}
          desc={plan.desc}
          priceMonthly={plan.priceMonthly}
          titleIcon={plan.titleIcon}
          primaryFeatures={plan.primary}
          secondaryFeatures={plan.secondary}
          ctaLabel={ctaLabel}
          accent={plan.accent}
          badge={plan.badge}
          badgeAlt={plan.title}
        />
      ))}
    </div>

  </div>
</section>

<style>
  [data-premium-plans] {
    padding-bottom: clamp(48px, 6vw, 96px);
  }
</style>
