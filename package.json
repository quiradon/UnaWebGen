{
  "name": "fortuna-web",
  "version": "1.0.0",
  "description": "A Static HTML page generator",
  "main": "index.js",
  "scripts": {
    "start": "wrangler pages dev dist/ d1 create",
    "build": "node build.js",
    "test": "npm test",
    "copy-static": "copyfiles -u 1 \"static/**/**/*\" dist/static",
    "copy-root-files": "copyfiles manifest.json robots.txt dist/static",
    "dev": "bun run build:dev && bun run start:dev",
    "build:dev": "bun run copy-static && bun run copy-root-files && bun run build.js",
    "start:dev": "bunx wrangler pages dev dist/ d1 create",
    "clean": "rimraf dist"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.0.0",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "copyfiles": "^2.4.1",
    "express": "^4.19.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.0",
    "html-minifier": "^4.0.0",
    "http": "^0.0.1-security",
    "p-limit": "^6.2.0",
    "progress": "^2.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "wrangler": "^4.19.1",
    "rimraf": "^5.0.5"
  }
}
