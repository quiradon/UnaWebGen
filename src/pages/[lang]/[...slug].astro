---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getLanguages, getRouteSlugs, resolveModuleAbsolutePathFromSlug, computeRotaFromAbsolutePath, loadT } from '@lib/i18n';
import { createRequire } from 'node:module';

export async function getStaticPaths() {
  const langs = getLanguages().filter((l) => l !== 'en');
  const slugs = getRouteSlugs();
  const EXCLUDES = ['index', 'privacy', 'tos', 'commands', 'systems', '404', 'tools', 'test'];
  const filtered = slugs.filter((s) => !EXCLUDES.includes(s) && !s.startsWith('systems/'));
  const paths: any[] = [];
  for (const lang of langs) {
    for (const slug of filtered) paths.push({ params: { lang, slug } });
  }
  return paths;
}

const lang = Astro.params.lang as string;
const slug = Astro.params.slug as string;
const t = loadT(lang);
const require = createRequire(import.meta.url);

const abs = resolveModuleAbsolutePathFromSlug(slug);
if (!abs) throw new Error(`Page not found: ${slug}`);
const mod = require(abs);
const rota = computeRotaFromAbsolutePath(abs);
const html = await mod.page(t, rota);
const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
let bodyHTML = bodyMatch?.[1] ?? html;
bodyHTML = bodyHTML.replace(/<nav[\s\S]*?<\/nav>/i, '').replace(/<footer[\s\S]*?<\/footer>/i, '');
---
<Layout t={t} route={rota} title={t?.index?.name ?? 'Mini Kraken'}>
  <Fragment set:html={bodyHTML} />
</Layout>
