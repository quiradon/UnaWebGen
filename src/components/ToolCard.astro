---
import GlassCard from "@components/ui-astro/GlassCard.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  icon?: any;
  iconColor?: string;
  exploreText?: string;
  class?: string;
  hoverLift?: boolean;
}

const {
  href,
  title,
  description,
  icon: Icon,
  iconColor = "text-primary",
  exploreText = "Explorar",
  class: className,
  hoverLift = true,
} = Astro.props;
---

<GlassCard
  as="a"
  href={href}
  class={`tool-card kr-tool-card text-decoration-none h-100 d-block ${className ?? ""}`}
  data-hover-lift={hoverLift ? "true" : "false"}
>
  <div class="card-body p-4 h-100 d-flex flex-column">
    <div class="icon-container mb-3">
      {Icon ? <Icon size={32} class={`tool-icon ${iconColor}`} /> : <slot />}
    </div>
    <h4 class="card-title text-white mb-2">{title}</h4>
    <p class="card-text text-secondary flex-grow-1">{description}</p>
    <div class="card-footer-indicator mt-auto">
      <span class="explore-text">{exploreText}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="arrow-icon"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </div>
  </div>
</GlassCard>

<style>
  .kr-tool-card {
    min-height: 240px;
    height: 100%;
  }

  .kr-tool-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(248, 7, 82, 0.1),
      rgba(248, 7, 82, 0.05)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .kr-tool-card:hover {
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
    border-color: rgba(248, 7, 82, 0.3);
  }

  .kr-tool-card[data-hover-lift="true"]:hover {
    transform: translateY(-8px);
  }

  .kr-tool-card:hover::before {
    opacity: 1;
  }

  .icon-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    transition: all 0.3s ease;
    position: relative;
  }

  .kr-tool-card:hover .icon-container {
    background: rgba(255, 255, 255, 0.1);
    transform: scale(1.1);
  }

  .tool-icon {
    transition: all 0.3s ease;
  }

  .kr-tool-card:hover .tool-icon {
    transform: scale(1.1);
    filter: drop-shadow(0 2px 8px rgba(248, 7, 82, 0.3));
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 600;
    transition: color 0.3s ease;
    line-height: 1.3;
  }

  .kr-tool-card:hover .card-title {
    color: rgba(255, 255, 255, 0.95) !important;
  }

  .card-text {
    font-size: 0.95rem;
    line-height: 1.5;
    transition: color 0.3s ease;
  }

  .kr-tool-card:hover .card-text {
    color: rgba(255, 255, 255, 0.8) !important;
  }

  .card-footer-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.3s ease;
    color: var(--bs-primary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .kr-tool-card:hover .card-footer-indicator {
    opacity: 1;
    transform: translateX(0);
  }

  .arrow-icon {
    transition: transform 0.3s ease;
  }

  .kr-tool-card:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Color variants */
  .text-primary {
    color: #f80752 !important;
  }
  .text-danger {
    color: #dc3545 !important;
  }
  .text-success {
    color: #22c55e !important;
  }
  .text-warning {
    color: #f59e0b !important;
  }
  .text-info {
    color: #06b6d4 !important;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .kr-tool-card {
      min-height: 200px;
      border-radius: 20px;
    }

    .icon-container {
      width: 56px;
      height: 56px;
    }

    .tool-icon {
      width: 28px;
      height: 28px;
    }

    .card-title {
      font-size: 1.1rem;
    }

    .card-text {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 576px) {
    .kr-tool-card {
      min-height: 180px;
      border-radius: 16px;
    }

    .card-body {
      padding: 1.25rem !important;
    }

    .icon-container {
      width: 48px;
      height: 48px;
      border-radius: 12px;
    }

    .tool-icon {
      width: 24px;
      height: 24px;
    }

    .card-title {
      font-size: 1rem;
    }

    .card-text {
      font-size: 0.85rem;
    }
  }
</style>
