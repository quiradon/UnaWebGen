---
export const prerender = true;

import Layout from '@layouts/Layout.astro';
import { markdownToHtml } from '@components/Markdown';
import { getLocale } from "astro-i18n-aut";
import { loadT } from '@lib/i18n';

export async function getStaticPaths() {
  // Lista de locales suportados
  const locales = ['en', 'pt', 'es', 'fr', 'de', 'ja', 'ko', 'ru', 'zh', 'it', 'pl', 'tr', 'hu', 'da', 'hr', 'id'];
  
  const paths = [];
  
  for (const locale of locales) {
    const t = await loadT(locale);
    const sistemas = Object.values(t.posts?.sistemas ?? {}) as any[];
    
    for (const sistema of sistemas) {
      if (sistema.path) {
        paths.push({
          params: { system: sistema.path }
        });
      }
    }
  }
  
  return paths;
}

const locale = getLocale(Astro.url);
const t = await loadT(locale);

const { system: slug } = Astro.params;
const sistemas = Object.values(t.posts?.sistemas ?? {}) as any[];
const sistema = sistemas.find((s: any) => s.path === slug);
if (!sistema) throw new Error(`System not found: ${slug}`);

const title = t.system?.default?.title?.replaceAll('%system%', sistema.card.title) ?? sistema.card.title;
const desc = t.system?.default?.desc?.replaceAll('%system%', sistema.card.title) ?? '';
const mdHtml = markdownToHtml(sistema.md ?? '');
const linkReplacer = (str: string) => str.replace(/\[(.*?)\]\((.*?)\)/gm, '<a href="$2">$1</a>');
---
<Layout t={t} title={title} desc={desc} pictureURL={sistema.bg ?? sistema.icon}>
  <section class="container-lg d-flex justify-content-center my-5" style="max-width: 1100px;">
    <div class="card border-0 shadow-sm w-100">
      {sistema.bg && (
        <div class="position-relative">
          <img src={sistema.bg} alt={title} class="w-100 rounded px-3" loading="eager" />
        </div>
      )}
      <div class="card-body px-4 py-4">
        <div class="mb-3">
          <div class="d-flex flex-wrap">
            {(sistema.tags ?? '').split(',').map((category: string) => (
              <span class="badge bg-primary text-light m-1">{category}</span>
            ))}
          </div>
          <h1 class="text-light fw-bold text-shadow mt-2">{title}</h1>
        </div>
        <div class="content">
          <Fragment set:html={mdHtml} />
        </div>
        <div class="mt-4">
          <div class="row mb-2">
            <div class="col-md-6 col-lg-6 col-xl-6">
              <div>
                <h2 class="text-light">{t.footer?.legal ?? 'Legal'}</h2>
                <p class="text-secondary lead"><Fragment set:html={linkReplacer(sistema.legal ?? '')} /></p>
              </div>
            </div>
            <div class="col-md-6 col-lg-6 col-xl-6 text-center mb-3">
              <img class="img-fluid" src={sistema.icon} alt={title} loading="eager" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
