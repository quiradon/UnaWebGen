---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getLanguages, loadT } from '@lib/i18n';

export async function getStaticPaths() {
  return getLanguages().map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const t = loadT(lang);
---
<Layout t={t} route="/secret" title={'Secret'}>
  <section class="photo-gallery py-4 py-xl-5">
    <div class="container">
      <div class="row mb-5">
        <div class="col-md-8 col-xl-6 text-center mx-auto">
          <h2>Secret</h2>
          <p class="w-lg-50">Estoque de Imagens Originais da Fortuna</p>
        </div>
      </div>
      <div class="row gx-2 gy-2 row-cols-1 row-cols-md-2 row-cols-xl-3 photos" data-bss-baguettebox>
        Secreto
      </div>
    </div>
  </section>
</Layout>

