---
import { idiomaR } from "@lib/routes";
import { loadT } from "@lib/i18n";
import config from "../config";
import { getLocale, getAllLocaleUrls } from "astro-i18n-aut";
import {
  Shapes,
  Wrench,
  Network,
  Wand,
  FileText,
  Book,
  Package,
  Fingerprint,
  Heart,
  Eye,
  Briefcase,
  MessageCircle,
  ChevronDown,
  Menu,
  X,
  Globe,
} from "@lucide/astro";
import LanguageSelector from "./navbar/LanguageSelector.astro";
import DesktopMenu from "./navbar/DesktopMenu.astro";
import MobileSidebar from "./navbar/MobileSidebar.astro";
import type { MenuSection, MenuItem } from "./navbar/MenuTypes";
import AuthWidget from "./AuthWidget.astro";

const { fixed = false, sticky = true } = Astro.props as {
  fixed?: boolean;
  sticky?: boolean;
};

const locale = getLocale(Astro.url);
const t = await loadT(locale);
const lang = idiomaR(t);
const allUrls = getAllLocaleUrls(Astro.url);
const localePaths = Object.fromEntries(
  Object.entries(allUrls).map(([code, url]) => {
    try {
      const u = new URL(url, Astro.url);
      return [code, u.pathname];
    } catch {
      return [code, url];
    }
  }),
);

export const brandNames: Record<string, string> = {
  en: "Mini Kraken",
  es: "Mini Kraken",
  fr: "Mini Kraken",
  pt: "Mini Kraken",
  de: "Mini Kraken",
  da: "Mini Kraken",
  hr: "Mini Kraken",
  hu: "Mini Kraken",
  id: "Mini Kraken",
  it: "Mini Kraken",
  ja: "ミニクラーケン",
  ko: "미니 크라켄",
  pl: "Mini Kraken",
  ru: "Мини Кракен",
  tr: "Mini Kraken",
  zh: "迷你克拉肯",
};

// Mapeamento de nomes de ícones para componentes Lucide
const iconMap: Record<string, any> = {
  Shapes: Shapes,
  Wrench: Wrench,
  Network: Network,
  Wand: Wand,
  FileText: FileText,
  Book: Book,
  Package: Package,
  Fingerprint: Fingerprint,
  Heart: Heart,
  Eye: Eye,
  Briefcase: Briefcase,
  MessageCircle: MessageCircle,
  ChevronDown: ChevronDown,
  Menu: Menu,
  X: X,
  Globe: Globe,
};

// SEÇÃO GUIDE
const guideSection: MenuSection = {
  id: "guide",
  title: t.nav.guide,
  icon: "Shapes",
  items: [
    {
      title: t.nav.vtt.title,
      description: t.nav.vtt.desc,
      href: "https://discord.com/discovery/applications/1300850389846855734",
      icon: "Network",
      iconColor: "text-danger",
      target: "_blank",
      badge: t.new,
    },
    {
      title: t.nav.docs.cmds.title,
      description: t.nav.docs.cmds.docs,
      href: `${lang}/commands/`,
      icon: "Wand",
      iconColor: "text-primary",
    },
    {
      title: t.nav.docs.dices.names,
      description: t.nav.docs.dices.desc,
      href: "https://dice-roller.github.io/documentation/guide/notation/",
      icon: "FileText",
      iconColor: "text-danger",
      target: "_blank",
    },
  ],
};

// SEÇÃO TOOLS
const toolsSection: MenuSection = {
  id: "tools",
  title: t.nav.tools.title,
  icon: "Wrench",
  items: [
    {
      title: t.nav.dices.title,
      description: t.nav.dices.desc,
      href: `${lang}/dices/`,
      icon: "Package",
      iconColor: "text-primary",
    },
    {
      title: t.nav.tools.names.title,
      description: t.nav.tools.names.desc,
      href: `${lang}/tools/names/`,
      icon: "Fingerprint",
      iconColor: "text-primary",
    },
    {
      title: t.nav.tools.poker.name,
      description: t.nav.tools.poker.desc,
      href: `${lang}/tools/poker/`,
      icon: "Heart",
      iconColor: "text-primary",
    },
    {
      title: t.nav.tools.tarot.name,
      description: t.nav.tools.tarot.desc,
      href: `${lang}/tools/tarot/`,
      icon: "Eye",
      iconColor: "text-primary",
    },
    {
      title: t.tools.all.title,
      description: t.tools.all.subtitle,
      href: `${lang}/tools/`,
      icon: "Briefcase",
      iconColor: "text-primary",
    },
  ],
};

// LINKS ADICIONAIS (Support, Premium, etc)
const additionalLinks: MenuItem[] = [
  {
    title: t.nav.support,
    description: "Discord",
    href: config.discord_invite,
    icon: "MessageCircle",
    iconColor: "text-primary",
    target: "_blank",
  },
];

// Array com todas as seções para facilitar iteração
const menuSections = [guideSection, toolsSection];
---

<style>
  #site-navbar {
    position: relative;
    z-index: 30;
  }

  .navbar {
    border-radius: 8px;
    border: 1px solid rgba(103, 125, 181, 0.18);
    backdrop-filter: opacity(1) blur(10px) saturate(100%) sepia(0%);
    background: rgba(11, 9, 16, 0.85);
    padding: auto;
  }

  .nav-link[type="button"] {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem 1rem;
    text-align: left;
  }

  .nav-link[type="button"]:hover {
    background: none;
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: none;
    background: rgba(var(--bs-primary-rgb), 0.1);
    color: var(--bs-primary);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .mobile-menu-toggle:hover {
    background: rgba(var(--bs-primary-rgb), 0.2);
    transform: scale(1.05);
  }

  @media (min-width: 992px) {
    .mobile-menu-toggle {
      display: none !important;
    }
  }
</style>

<script>
  // JavaScript simplificado para melhor performance no dev mode
  let navbarAbortController: AbortController | null = null;
  function initNavbarInteractions() {
    navbarAbortController?.abort();
    navbarAbortController = new AbortController();
    const { signal } = navbarAbortController;
    // Gerenciamento básico do sidebar mobile
    const sidebarOverlay = document.querySelector(".mobile-sidebar-overlay");
    const sidebar = document.querySelector(".mobile-sidebar");
    const openButtons = document.querySelectorAll(".mobile-menu-toggle");
    const closeButton = document.querySelector(".mobile-sidebar-close");

    function openSidebar() {
      sidebar?.classList.add("show");
      sidebarOverlay?.classList.add("show");
      document.body.style.overflow = "hidden";
    }

    function closeSidebar() {
      sidebar?.classList.remove("show");
      sidebarOverlay?.classList.remove("show");
      document.body.style.overflow = "";
    }

    // Event listeners
    openButtons.forEach((button) => {
      button.addEventListener("click", openSidebar, { signal });
    });

    closeButton?.addEventListener("click", closeSidebar, { signal });
    sidebarOverlay?.addEventListener("click", closeSidebar, { signal });

    // Fechar com ESC
    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape") closeSidebar();
      },
      { signal },
    );

    // Fechar ao clicar em links
    sidebar?.querySelectorAll("a").forEach((link) => {
      link.addEventListener(
        "click",
        () => {
          setTimeout(() => {
            if (signal.aborted) return;
            closeSidebar();
          }, 100);
        },
        { signal },
      );
    });

    // Animações hover simples (apenas desktop)
    if (window.innerWidth >= 992) {
      document
        .querySelectorAll("[data-bss-hover-animate]")
        .forEach((element) => {
          const htmlElement = element as HTMLElement;
          const animationClass = htmlElement.dataset.bssHoverAnimate;
          if (!animationClass) return;

          element.addEventListener(
            "mouseenter",
            () => {
              element.classList.add("animated", animationClass);
            },
            { signal },
          );

          element.addEventListener(
            "mouseleave",
            () => {
              element.classList.remove("animated", animationClass);
            },
            { signal },
          );
        });
    }
  }

  // Garante init no primeiro carregamento (mesmo se astro:page-load nAœo disparar)
  document.addEventListener("astro:page-load", initNavbarInteractions);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNavbarInteractions, {
      once: true,
    });
  } else {
    initNavbarInteractions();
  }
</script>

<nav id="site-navbar" class={`${fixed ? "fixed-top" : sticky ? "sticky-top" : ""} p-2`}>
  <div class="navbar navbar-expand-lg mx-1 mx-md-4 px-2 mt-2">
    <div class="container-fluid">
      <a
        class="navbar-brand fs-2 fw-bold d-flex align-items-center"
        href={`${lang}/`}
        aria-label={`${brandNames[locale] ?? brandNames["en"]} - ${t.nav.guide || "Home"}`}
      >
        <span class="fs-3 fw-bold" style="font-family: Roboto, sans-serif;"
          >{brandNames[locale] ?? brandNames["en"]}</span
        >
      </a>

      <div id="navcol-2" class="collapse navbar-collapse">
        <ul class="navbar-nav ms-auto">
          <DesktopMenu sections={menuSections} iconMap={iconMap} />

          <!-- Links adicionais (Support, etc) -->
          {
            additionalLinks.map((link) => {
              const LinkIcon = iconMap[link.icon];
              return (
                <li class="nav-item">
                  <a
                    class="nav-link d-xxl-flex justify-content-xxl-center align-items-xxl-center"
                    target={link.target}
                    href={link.href}
                    aria-label={`${link.title} - ${link.description}`}
                  >
                    <LinkIcon class="me-1" size={16} />
                    {link.title}
                  </a>
                </li>
              );
            })
          }

          <LanguageSelector />
        </ul>
        <AuthWidget t={t} />
      </div>

      <!-- Botão para abrir menu mobile -->
      <button class="mobile-menu-toggle d-lg-none" aria-label="Abrir menu">
        <Menu size={24} />
      </button>
    </div>
  </div>
</nav>

{
  fixed && (
    <script is:inline>
      {`
      function __updateNavbarOffset() {
        const nav = document.getElementById("site-navbar");
        if (!nav) return;
        const height = nav.getBoundingClientRect().height;
        document.documentElement.style.setProperty("--navbar-offset", height + "px");
      }

      document.addEventListener("astro:page-load", __updateNavbarOffset);
      window.addEventListener("resize", __updateNavbarOffset);
      window.addEventListener("astro:after-swap", __updateNavbarOffset);
      window.addEventListener("load", __updateNavbarOffset);
      requestAnimationFrame(__updateNavbarOffset);
      `}
    </script>
  )
}

<MobileSidebar
  sections={menuSections}
  additionalLinks={additionalLinks}
  iconMap={iconMap}
  t={t}
  lang_FLAGS={{
    pt: "/img/flags/br.svg",
    en: "/img/flags/en.svg",
    es: "/img/flags/es.svg",
    de: "/img/flags/de.svg",
    fr: "/img/flags/fr.svg",
    zh: "/img/flags/cn.svg",
    ja: "/img/flags/jp.svg",
    ru: "/img/flags/ru.svg",
    ko: "/img/flags/ko.svg",
    it: "/img/flags/it.svg",
    pl: "/img/flags/pl.svg",
    tr: "/img/flags/tr.svg",
    hu: "/img/flags/hu.svg",
    id: "/img/flags/id.svg",
    da: "/img/flags/dk.svg",
    hr: "/img/flags/hr.svg",
  }}
  lang_LABELS={{
    en: "English",
    zh: "中文",
    es: "Español",
    fr: "Français",
    de: "Deutsch",
    pt: "Português",
    ru: "Русский",
    ja: "日本語",
    ko: "한국어",
    it: "Italiano",
    tr: "Türkçe",
    pl: "Polski",
    hu: "Magyar",
    da: "Danish",
    hr: "Croatian",
    id: "Indonesian",
  }}
  allUrls={localePaths}
/>




