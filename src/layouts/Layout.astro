---
import Head from "@components/Head.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import type { Translations } from "@lib/i18n";
import config from "../config";

interface Props {
  t: Translations;
  title: string;
  desc?: string;
  pictureURL?: string;
}

const { t, title, desc, pictureURL } = Astro.props as Props;
---

<html lang={t.lang} data-bs-theme="dark">
  <Head title={title} desc={desc} pictureURL={pictureURL} />
  <body>
    <ClientRouter />
    <Navbar t={t} />
    <main class="main-content" transition:animate="fade">
      <slot />
    </main>
    <Footer t={t} />
    <script is:inline src="/bootstrap/js/bootstrap.min.js"></script>
    <!-- Carrega versões já geradas em public/scripts para evitar MIME errado -->
    <script type="module" src="/scripts/session-prime.js"></script>
    <script src="../scripts/auth-widget.ts"></script>
  </body>
</html>

<style is:global>
  html,
  body {
    height: 100%;
    margin: 0;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  footer {
    flex-shrink: 0;
    margin-top: auto;
  }
</style>
