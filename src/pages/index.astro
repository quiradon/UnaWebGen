---
import { Image } from "astro:assets";
export const prerender = true;
import { getLocale } from "astro-i18n-aut";
import Layout from "@layouts/Layout.astro";
import { loadT } from "@lib/i18n";
import { idiomaR } from "@lib/routes";
import config from "../config";
import {
  Heart,
  Gem,
  Clipboard,
  Grid3x3,
  Users,
  Circle,
  Layers,
  CreditCard,
  Database,
} from "@lucide/astro";
import TrustedCommunities from "@components/TrustedCommunities.astro";
import MultiSystems from "@components/MultiSystems.astro";
import PremiumPlans from "@components/Premium/Plans.astro";
import SupportModal from "@components/Modal/SupportModal.astro";

import image1 from "../assets/img/landing/place.webp";
import image2 from "../assets/img/landing/dices.webp";
import imageSheet from "../assets/img/landing/sheets.webp";
import imageVTT from "../assets/img/landing/vtt2.webp";

const t = await loadT(getLocale(Astro.url));
const langPrefix = idiomaR(t);

const landingHTML = (t.index?.landing?.text ?? "").replace(
  /\*\*(.*?)\*\*/g,
  '<span class="text-primary">$1<\/span>',
);
const sistemas: Record<string, any> = t.posts?.sistemas ?? {};

---

<Layout
  t={t}
  title={t.index?.name ?? "Mini Kraken"}
  desc={t.index?.desc ?? "test"}
  useBootstrapJS={true}
>
  <head>
    <link
      rel="preload"
      as="image"
      href="/img/bg/pattern-square.svg"
      type="image/svg+xml"
    />
  </head>
  <style>
    .bgImg2 {
      background:
        linear-gradient(var(--bs-dark) 0%, rgba(255, 255, 255, 0)),
        linear-gradient(rgba(255, 255, 255, 0) 65%, var(--bs-dark) 100%),
        url("/img/bg/dnd.webp") center / cover repeat-x;
    }
    .hero-bg {
      background: url("/img/bg/pattern-square.svg") top / auto repeat-x;
    }
  </style>
  <script>
    document.addEventListener("astro:page-load", () => {
      // Old manual scroll logic removed
    });
  </script>
  <!-- Hero -->
  <section id="inicio" class="hero-bg">
    <div class="container d-lg-flex align-items-lg-center py-4 py-xl-5">
      <div class="row gy-2 gy-md-0 row-cols-1 row-cols-lg-2 my-3 py-3">
        <div
          class="col-auto col-xl-6 text-center text-md-start d-flex d-sm-flex d-md-flex justify-content-center align-items-center justify-content-md-start align-items-md-center justify-content-xl-center"
        >
          <div class="mb-5">
            <h1 class="display-1 fw-bold">
              <Fragment set:html={landingHTML} />
            </h1>
            <p class="text-secondary lead">{t.index?.start?.desc}</p>
            <a
              class="btn btn-primary btn-lg mt-1 border-2 px-5 me-1 generic_grow fw-bold"
              href={config.bot_invite}
              target="_blank">{t.nav?.add}</a
            >
            <a
              class="btn btn-primary btn-lg mt-1 border-2 px-4 generic_grow fw-bold"
              href={`${langPrefix}/tools/`}>{t.online?.tools?.btn}</a
            >
          </div>
        </div>
        <div
          class="col-lg-6 col-xl-6 d-md-flex justify-content-md-center align-items-md-center p-0 m-0"
        >
          <Image
            class="img-fluid generic_grow"
            alt="Mini Kraken RPG | Inanimalia Fortuna in Dungeon Background"
            width="600"
            height="400"
            src={image1}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Systems carousel -->
  <MultiSystems
    sistemas={sistemas}
    langPrefix={langPrefix}
    title={t.index?.system?.title}
    desc={t.index?.system?.desc}
    subtitle={t.index?.system?.subtitle}
    allSystemsText={t.index?.allSystems?.text}
  />

  <!-- Dice section -->
  <section>
    <div class="container">
      <div class="row py-5">
        <div class="col-lg-6 col-xl-6 d-lg-flex align-items-lg-center">
          <div class="mb-5">
            <h4 class="fw-semibold text-primary mb-0">
              {t.index?.dices?.subtitle}
            </h4>
            <h1 class="display-5 fw-bold mt-0">{t.index?.dices?.title}</h1>
            <p class="lead text-secondary">{t.index?.dices?.desc}</p>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6">
          <Image
            class="img-fluid generic_grow"
            alt="Mini Kraken RPG | Dice roll Illustration"
            inferSize={true}
            src={image2}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted Communities -->
  <TrustedCommunities
    title={t.parceiros?.titulo}
    desc={t.parceiros?.desc1}
    desc2={t.parceiros?.desc2}
    members={t.common.users}
  />

  <!-- Sheets section -->
  <section>
    <div class="container">
      <div class="row py-5">
        <div class="col-lg-6 col-xl-6 d-lg-flex align-items-lg-center">
          <div class="mb-5">
            <h4 class="fw-semibold text-primary mb-0">
              {t.character?.sheet?.subtitle}
            </h4>
            <h1 class="display-5 fw-bold mt-0">{t.character?.sheet?.title}</h1>
            <p class="lead text-secondary">{t.character?.sheet?.desc}</p>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6">
          <Image
            class="img-fluid p-4 generic_grow"
            inferSize={true}
            alt="RPG Characters Sheets"
            src={imageSheet}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Features cards -->
  <section class="bgImg2">
    <div class="container py-4 py-xl-5">
      <h2 class="text-light display-5 fw-bold mt-0">
        {t.index?.features?.title}
      </h2>
      <p class="lead text-secondary mt-1 mb-5">{t.index?.features?.desc}</p>
      <div class="row gy-4 row-cols-1 row-cols-md-2 row-cols-xl-3 d-flex">
        <!-- Card 0 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Heart class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[0]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[0]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 1 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Gem class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[1]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[1]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Clipboard class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[2]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[2]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Grid3x3 class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[3]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[3]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Users class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[4]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[4]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Circle class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[5]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[5]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Layers class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[6]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[6]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 7 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <CreditCard class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[7]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[7]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 8 -->
        <div class="col d-flex mt-1 mb-3">
          <div
            class="card border-white border-0 shadow glass-container cardBonito"
          >
            <div class="card-body p-4">
              <div>
                <div
                  class="d-flex justify-content-center align-items-center align-content-center"
                >
                  <div
                    class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon"
                  >
                    <Database class="text-primary" size={32} />
                  </div>
                </div>
                <h3 class="text-center text-white card-title">
                  {t.index?.func?.card?.[8]?.title}
                </h3>
                <p class="text-start text-light card-text">
                  {t.index?.func?.card?.[8]?.desc}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VTT section -->
  <section>
    <div class="container">
      <div class="row py-5">
        <div class="col-lg-6 col-xl-6 d-lg-flex align-items-lg-center">
          <div class="mb-5">
            <h1 class="display-5 fw-bold mt-0">{t.vtt?.index?.title}</h1>
            <p class="lead text-secondary">{t.vtt?.index?.desc}</p>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6 mb-5">
          <Image
            class="img-fluid generic_grow"
            inferSize={true}
            alt="Mini Kraken VTT Ilustration"
            src={imageVTT}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Premium plans + modal -->
  <PremiumPlans t={t} />

  <!-- Modal -->
  <SupportModal/>

  <!-- Page specific scripts -->
<script is:inline type="module">
  let indexAbortController = null;

  function initIndexPage() {
    indexAbortController?.abort();
    indexAbortController = new AbortController();
    const { signal } = indexAbortController;

    // Move modal to body to fix z-index issues with backdrop
    const modalEl = document.getElementById("premium_modal");
    if (modalEl && modalEl.parentElement !== document.body) {
      document.body.appendChild(modalEl);
    }

    // Modal Deep Linking
    const handleHashModal = () => {
      if (window.location.hash === "#premium_modal") {
        if (modalEl && window.bootstrap) {
          const modal =
            window.bootstrap.Modal.getInstance(modalEl) ||
            new window.bootstrap.Modal(modalEl);
          modal.show();
        }
      }
    };

    // Check on load
    handleHashModal();

    // Retry once assets (Bootstrap) are loaded
    window.addEventListener("load", handleHashModal, { once: true, signal });

    // Check on hash change
    window.addEventListener("hashchange", handleHashModal, { signal });
  }

  document.addEventListener("astro:page-load", initIndexPage);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initIndexPage, { once: true });
  } else {
    initIndexPage();
  }
</script>

</Layout>




