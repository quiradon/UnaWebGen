---
interface Props {
  children: any;
}

const { children } = Astro.props;
---

<div class="support-modal__body">
  <slot />
</div>

<style>
  .support-modal__body {
    padding: 20px 24px 18px;
    display: grid;
    gap: 20px;
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  @media (max-width: 768px) {
    .support-modal__body {
      padding-left: 18px;
      padding-right: 18px;
    }
  }
</style>
