---
export const prerender = true;
import SvelteCounter from "../components/SvelteCounter.svelte";
import Layout from "@layouts/Layout.astro";
import { loadT } from "@lib/i18n";

import { getLocale } from "astro-i18n-aut";
const locale = getLocale(Astro.url);
const t = loadT(locale);
---

<Layout t={t} title={"Secret"}>
    <section class="photo-gallery py-4 py-xl-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-md-8 col-xl-6 text-center mx-auto">
                    <h2>Secret</h2>
                    <p class="w-lg-50">
                        Estoque de Imagens Originais da Fortuna
                    </p>
                </div>
            </div>
            <div
                class="row gx-2 gy-2 row-cols-1 row-cols-md-2 row-cols-xl-3 photos"
                data-bss-baguettebox
            >
                <SvelteCounter client:load />
            </div>
        </div>
    </section>
</Layout>
