---
// Página de redirecionamento para a página inicial localizada
// Esta página é obrigatória quando prefixDefaultLocale: false
// Redireciona automaticamente para /<defaultLocale>
import { DEFAULT_LOCALE } from '../lib/i18n';

// Redireciona para a página inicial do idioma padrão
return Astro.redirect(`/${DEFAULT_LOCALE}/`);
