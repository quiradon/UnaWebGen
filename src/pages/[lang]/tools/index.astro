---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getLanguages, loadT } from '@lib/i18n';
import { idiomaR } from '@lib/routes';

export async function getStaticPaths() {
  // Build tools index for all languages, including 'en'
  return getLanguages().map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang as string;
const t = loadT(langParam);
const lang = idiomaR(t);
---
<Layout t={t} route="/tools" title={t.tools?.section?.title} desc={t.tools?.section?.desc}>
  <section id="inicio" style="background: url('pattern-square.svg') top / auto repeat-x;">
    <div class="container py-3">
      <div>
        <h1 class="display-5 fw-bold text-white">{t.tools?.section?.title}</h1>
        <p class="lead text-secondary">{t.tools?.section?.desc}</p>
      </div>
    </div>
    <div class="container py-4">
      <div class="row gy-4 row-cols-1 row-cols-md-2 row-cols-xl-3 flex grow">
        <div class="col-xxl-4 d-flex">
          <a href={`${lang}/dices`} class="card system_card text-decoration-none flex-grow-1">
            <div class="card-body d-flex flex-column p-4">
              <div class="bs-icon-md bs-icon-rounded bs-icon-primary d-flex justify-content-center align-items-center d-inline-block mb-3 bs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg></div>
              <h4 class="card-title">{t.nav?.dices?.title}</h4>
              <p class="card-text flex-grow-1">{t.nav?.dices?.desc}</p>
            </div>
          </a>
        </div>
        <div class="col-xxl-4 d-flex">
          <a href={`${lang}/tools/poker`} class="card system_card text-decoration-none flex-grow-1">
            <div class="card-body d-flex flex-column p-4">
              <div class="bs-icon-md bs-icon-rounded bs-icon-primary d-flex justify-content-center align-items-center d-inline-block mb-3 bs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></div>
              <h4 class="card-title">{t.nav?.tools?.poker?.name}</h4>
              <p class="card-text flex-grow-1">{t.nav?.tools?.poker?.desc}</p>
            </div>
          </a>
        </div>
        <div class="col-xxl-4 d-flex">
          <a href={`${lang}/tools/tarot`} class="card system_card text-decoration-none flex-grow-1">
            <div class="card-body d-flex flex-column p-4">
              <div class="bs-icon-md bs-icon-rounded bs-icon-primary d-flex justify-content-center align-items-center d-inline-block mb-3 bs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg></div>
              <h4 class="card-title">{t.nav?.tools?.tarot?.name}</h4>
              <p class="card-text flex-grow-1">{t.nav?.tools?.tarot?.desc}</p>
            </div>
          </a>
        </div>
        <div class="col-xxl-4 d-flex">
          <a href={`${lang}/tools/names`} class="card system_card text-decoration-none flex-grow-1">
            <div class="card-body d-flex flex-column p-4">
              <div class="bs-icon-md bs-icon-rounded bs-icon-primary d-flex justify-content-center align-items-center d-inline-block mb-3 bs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M2 12a10 10 0 0 1 18-6"/><path d="M2 16h.01"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M9 6.8a6 6 0 0 1 9 5.2v2"/></svg></div>
              <h4 class="card-title">{t.nav?.tools?.names?.title}</h4>
              <p class="card-text flex-grow-1">{t.nav?.tools?.names?.desc}</p>
            </div>
          </a>
        </div>
        <div class="col-xxl-4 d-flex">
          <a href={`${lang}/tools/coinflip`} class="card system_card text-decoration-none flex-grow-1">
            <div class="card-body d-flex flex-column p-4">
              <div class="bs-icon-md bs-icon-rounded bs-icon-primary d-flex justify-content-center align-items-center d-inline-block mb-3 bs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dollar-sign-icon lucide-circle-dollar-sign"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg></div>
              <h4 class="card-title">{t.flip_coin?.title}</h4>
              <p class="card-text flex-grow-1">{t.flip_coin?.description}</p>
            </div>
          </a>
        </div>
        <div class="col-xxl-4 d-flex">
          <a href={`${lang}/tools/weather`} class="card system_card text-decoration-none flex-grow-1">
            <div class="card-body d-flex flex-column p-4">
              <div class="bs-icon-md bs-icon-rounded bs-icon-primary d-flex justify-content-center align-items-center d-inline-block mb-3 bs-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-tornado-icon lucide-tornado"><path d="M21 4H3"/><path d="M18 8H6"/><path d="M19 12H9"/><path d="M16 16h-6"/><path d="M11 20H9"/></svg></div>
              <h4 class="card-title">{t.tools?.clima?.pageTitle}</h4>
              <p class="card-text flex-grow-1">{t.tools?.clima?.pageDesc}</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
