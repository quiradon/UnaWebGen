---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT } from '@lib/i18n';

const t = loadT('en');
const route = '/tools/weather';
---
<Layout t={t} route={route} title={t.tools?.clima?.pageTitle} desc={t.tools?.clima?.pageDesc}>
  <section class="justify-content-lg-center pt-2 mt-4 mb-4">
    <div class="container">
      <div class="col-12 mb-2">
        <h1 class="display-5 fw-bold text-white mb-3">{t.tools?.clima?.pageTitle}</h1>
        <p class="lead text-secondary">{t.tools?.clima?.pageDesc}</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card">
            <div class="card-body">
              <div class="mb-3">
                <label for="city" class="form-label">City</label>
                <input id="city" type="text" class="form-control" placeholder="London" />
              </div>
              <button id="ask" class="btn btn-primary">Get Weather</button>
              <div id="out" class="mt-3"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById('ask')?.addEventListener('click', () => {
      const city = (document.getElementById('city') as HTMLInputElement).value || 'London';
      (document.getElementById('out') as HTMLElement).textContent = `Weather in ${city}: clear sky (mocked)`;
    });
  </script>
</Layout>

