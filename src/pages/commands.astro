---
import Layout from '@layouts/Layout.astro';
import CommandCard from '@components/CommandCard.astro';

import { Terminal, Code2, Sparkles, Search } from '@lucide/astro';
import { getLocale } from "astro-i18n-aut";
import { loadT } from '@lib/i18n';
const locale = getLocale(Astro.url);
const t = loadT(locale);

type Cmd = {
  name: string;
  description: string;
  name_localizations?: Record<string, string>;
  description_localizations?: Record<string, string>;
  options?: CmdOption[];
};
type CmdOption = Cmd & { type: number };

async function getCommands(): Promise<Cmd[]> {
  const url = 'https://una-api.arkanus.app/commands';
  const res = await fetch(url);
  const data = (await res.json()) as Cmd[];
  return Array.isArray(data) ? data : [];
}

function formatName(cmd: Cmd, lang: string) {
  return cmd.name_localizations?.[lang] ?? cmd.name;
}

function formatDescription(cmd: Cmd, lang: string) {
  return cmd.description_localizations?.[lang] ?? cmd.description;
}

function replaceText(text = '') {
  return text
    .replace(/\n/g, '<br />')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/@(\w+)/g, '<span class="text-primary">@$1</span>')
    .replace(/`(.*?)`/g, '<span class="text-bg-primary">$1</span>')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank">$1</a>');
}

function processCommand(cmd: Cmd, lang: string, parentName = ''): { command: string; description: string; options: string; optionsDescriptions: string } | null {
  
  let optionsSpans = '';
  let optionsDescriptions = '';
  
  if (cmd.options) {
    optionsSpans = cmd.options
      .map((option) => {
        const optionName = formatName(option, lang);
        return `<span class="badge rounded-pill bg-primary me-1">${optionName}</span>`;
      })
      .join('');

    optionsDescriptions = cmd.options
      .map((option) => {
        const optionName = formatName(option, lang);
        const optionDescription = replaceText(formatDescription(option, lang));
        return `<strong>${optionName}:</strong> ${optionDescription}`;
      })
      .join('<br />');
  }

  const name = formatName(cmd, lang);
  const description = replaceText(formatDescription(cmd, lang));
  const fullName = parentName ? `${parentName} ${name}` : name;
  const isFinal = !cmd.options || cmd.options.every((o) => o.type !== 1 && o.type !== 2);
  
  if (isFinal) {
    return {
      command: fullName, // Mantém os espaços no nome completo
      description,
      options: optionsSpans,
      optionsDescriptions
    };
  }
  
  return null;
}

function getAllFinalCommands(commands: Cmd[], lang: string): Array<{ command: string; description: string; options: string; optionsDescriptions: string }> {
  const finalCommands: Array<{ command: string; description: string; options: string; optionsDescriptions: string }> = [];
  
  function processRecursively(cmd: Cmd, parentName = '') {
    const processed = processCommand(cmd, lang, parentName);
    if (processed) {
      finalCommands.push(processed);
    } else if (cmd.options) {
      const currentName = parentName ? `${parentName} ${formatName(cmd, lang)}` : formatName(cmd, lang);
      cmd.options
        .filter((o) => o.type === 1 || o.type === 2)
        .forEach((o) => processRecursively(o, currentName));
    }
  }
  
  commands.forEach(cmd => processRecursively(cmd));
  return finalCommands;
}

const apiLang = t.lang === 'pt' ? 'pt-BR' : 'en-US';
const commands = await getCommands();
const finalCommands = getAllFinalCommands(commands, apiLang);
---

<Layout t={t} title={t.cmds?.title} desc={t.cmds?.seo}>
  <section class="commands-section pt-2 mt-4 mb-5">
    <div class="container">
      <!-- Header -->
      <div class="commands-header text-center mb-5 mt-5">
        <h1 class="display-4 fw-bold text-white mb-3 animate-fade-in">
          <Terminal size={40} class="me-2 d-inline-block" style="color: var(--bs-primary);" />
          {t.cmds?.title}
        </h1>
        <p class="lead text-secondary animate-fade-in-delay">{t.cmds?.desc}</p>
        
        <!-- Search Bar -->
        <div class="search-container mt-4 animate-slide-up">
          <div class="search-wrapper">
            <Search size={20} class="search-icon" />
            <input 
              type="text" 
              id="commandSearch" 
              class="search-input"
              placeholder="Buscar comandos..."
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <!-- Commands Stats -->
      <div class="commands-stats mb-5 animate-slide-up-delay">
        <div class="row g-5 justify-content-center">
          </div>
        </div>
      </div>

      <!-- Commands Grid -->
      <div class="commands-grid" id="commandsGrid">
        {finalCommands.map((cmd) => (
          <CommandCard
            command={cmd.command}
            description={cmd.description}
            options={cmd.options}
            optionsDescriptions={cmd.optionsDescriptions}
          />
        ))}
      </div>
  </section>

  <style>
    .commands-section {
      min-height: 70vh;
      position: relative;
    }

    /* Header animations */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fadeIn 0.8s ease-out;
    }

    .animate-fade-in-delay {
      animation: fadeIn 0.8s ease-out 0.2s both;
    }

    .animate-slide-up {
      animation: slideUp 0.8s ease-out 0.4s both;
    }

    .animate-slide-up-delay {
      animation: slideUp 0.8s ease-out 0.6s both;
    }

    /* Search container */
    .search-container {
      max-width: 500px;
      margin: 0 auto;
    }

    .search-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      color: rgba(255, 255, 255, 0.5);
      z-index: 2;
    }

    .search-input {
      width: 100%;
      padding: 1rem 1rem 1rem 3rem;
      background: rgba(255, 255, 255, 0.08);
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      color: white;
      font-size: 1rem;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
    }

    .search-input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .search-input:focus {
      outline: none;
      border-color: #f80752;
      background: rgba(248, 7, 82, 0.1);
      box-shadow: 0 0 0 4px rgba(248, 7, 82, 0.2);
    }

    /* Stats cards */
    .commands-stats {
      opacity: 0;
      animation: slideUp 0.8s ease-out 0.6s both;
    }

    .stat-card {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(248, 7, 82, 0.3);
      transform: translateY(-2px);
    }

    .stat-icon {
      color: #f80752;
      flex-shrink: 0;
    }

    .stat-content {
      display: flex;
      flex-direction: column;
    }

    .stat-number {
      font-size: 1.5rem;
      font-weight: 700;
      color: white;
      line-height: 1;
    }

    .stat-label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.7);
      margin-top: 0.25rem;
    }

    /* Commands grid */
    .commands-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      max-width: 900px;
      margin: 0 auto;
    }

    /* Initial animation for command cards */
    .commands-grid .command-card {
      opacity: 0;
      transform: translateY(20px);
      animation: slideInUp 0.6s ease-out forwards;
    }

    @keyframes slideInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Stagger animation delay for multiple cards */
    .commands-grid .command-card:nth-child(1) { animation-delay: 0.8s; }
    .commands-grid .command-card:nth-child(2) { animation-delay: 0.9s; }
    .commands-grid .command-card:nth-child(3) { animation-delay: 1.0s; }
    .commands-grid .command-card:nth-child(4) { animation-delay: 1.1s; }
    .commands-grid .command-card:nth-child(5) { animation-delay: 1.2s; }
    .commands-grid .command-card:nth-child(n+6) { animation-delay: 1.3s; }

    /* No results */
    .no-results {
      padding: 3rem 1rem;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.4s ease;
    }

    .no-results.show {
      opacity: 1;
      transform: translateY(0);
    }

    .no-results-icon {
      color: rgba(255, 255, 255, 0.3);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .commands-header {
        margin-top: 2rem !important;
        margin-bottom: 3rem !important;
      }

      .search-input {
        padding: 0.875rem 0.875rem 0.875rem 2.75rem;
        font-size: 0.95rem;
      }

      .search-icon {
        left: 0.875rem;
        width: 18px;
        height: 18px;
      }

      .stat-card {
        padding: 1.25rem;
      }

      .stat-number {
        font-size: 1.25rem;
      }

      .stat-label {
        font-size: 0.85rem;
      }
    }

    @media (max-width: 576px) {
      .commands-grid {
        gap: 1rem;
      }

      .search-container {
        max-width: 100%;
      }
    }

    /* Filter transition */
    .commands-grid .command-card {
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .commands-grid .command-card.hidden {
      opacity: 0;
      transform: scale(0.95) translateY(20px);
      pointer-events: none;
      margin-bottom: 0;
      max-height: 0;
      overflow: hidden;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Search functionality
      const searchInput = document.getElementById('commandSearch');
      const commandsGrid = document.getElementById('commandsGrid');
      const noResults = document.getElementById('noResults');
      
      if (!searchInput || !commandsGrid || !noResults) return;
      
      function filterCommands() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const commandCards = commandsGrid.querySelectorAll('.command-card');
        let visibleCount = 0;

        commandCards.forEach((card) => {
          const commandName = card.querySelector('.command-name')?.textContent?.toLowerCase() || '';
          const description = card.querySelector('.command-description')?.textContent?.toLowerCase() || '';
          const options = card.querySelector('.command-options')?.textContent?.toLowerCase() || '';
          
          const isVisible = 
            commandName.includes(searchTerm) || 
            description.includes(searchTerm) || 
            options.includes(searchTerm);

          if (isVisible) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Show/hide no results message
        if (visibleCount === 0 && searchTerm !== '') {
          noResults.style.display = 'block';
          setTimeout(() => noResults.classList.add('show'), 10);
        } else {
          noResults.classList.remove('show');
          setTimeout(() => {
            if (!noResults.classList.contains('show')) {
              noResults.style.display = 'none';
            }
          }, 400);
        }
      }

      // Add event listener for search
      searchInput.addEventListener('input', filterCommands);

      // Clear search on escape
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          filterCommands();
          searchInput.blur();
        }
      });
      
      // Focus search with Ctrl+K or Cmd+K
      document.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
          e.preventDefault();
          searchInput.focus();
        }
      });
    });
  </script>
</Layout>

