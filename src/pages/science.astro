---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT } from '@lib/i18n';
import { markdownToHtml } from '@components/Markdown';

import { getLocale } from "astro-i18n-aut";
const locale = getLocale(Astro.url);
const t = await loadT(locale);
const html = markdownToHtml(t.blog.post[0].content ?? '');
---
<Layout t={t} title={t.tos?.title} desc={t.tos?.desc} pictureURL="/img/banners/terms_of_service_banner.webp">
  <section class="container-lg d-flex justify-content-center my-5" style="max-width: 1100px;">
    <div class="card border-0 w-100">
      <div class="position-relative">
        <img src="/img/banners/terms_of_service_banner.webp" alt={t.tos?.title} class="w-100 rounded px-3" loading="eager" />
      </div>
      <div class="card-body px-4 py-4">
        <div class="content">
          <Fragment set:html={html} />
        </div>
      </div>
    </div>
  </section>
  <script src="../scripts/image-zoom.ts"></script>
</Layout>





