---
import Layout from "@layouts/Layout.astro";
import CommandCard from "@components/CommandCard.astro";

import { Terminal, Search, Hash, ChevronRight } from "@lucide/astro";
import { getLocale } from "astro-i18n-aut";
import { loadT } from "@lib/i18n";
const locale = getLocale(Astro.url);
const t = loadT(locale);

type Cmd = {
  name: string;
  description: string;
  name_localizations?: Record<string, string>;
  description_localizations?: Record<string, string>;
  options?: CmdOption[];
};
type CmdOption = Cmd & { type: number };

async function getCommands(): Promise<Cmd[]> {
  const url = "https://api-rpg.arkanus.app/bot/commands";
  const res = await fetch(url);
  const data = (await res.json()) as Cmd[];
  return Array.isArray(data) ? data : [];
}

function formatName(cmd: Cmd, lang: string) {
  return cmd.name_localizations?.[lang] ?? cmd.name;
}

function formatDescription(cmd: Cmd, lang: string) {
  return cmd.description_localizations?.[lang] ?? cmd.description;
}

function replaceText(text = "") {
  return text
    .replace(/\n/g, "<br />")
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
    .replace(/@(\w+)/g, '<span class="text-primary">@$1</span>')
    .replace(/`(.*?)`/g, '<span class="text-bg-primary">$1</span>')
    .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" target="_blank">$1</a>');
}

function processCommand(
  cmd: Cmd,
  lang: string,
  parentName = "",
): {
  command: string;
  description: string;
  options: string;
  optionsDescriptions: string;
} | null {
  let optionsSpans = "";
  let optionsDescriptions = "";

  if (cmd.options) {
    optionsSpans = cmd.options
      .map((option) => {
        const optionName = formatName(option, lang);
        return `<span class="badge rounded-pill bg-primary me-1">${optionName}</span>`;
      })
      .join("");

    optionsDescriptions = cmd.options
      .map((option) => {
        const optionName = formatName(option, lang);
        const optionDescription = replaceText(formatDescription(option, lang));
        return `<strong>${optionName}:</strong> ${optionDescription}`;
      })
      .join("<br />");
  }

  const name = formatName(cmd, lang);
  const description = replaceText(formatDescription(cmd, lang));
  const fullName = parentName ? `${parentName} ${name}` : name;
  const isFinal =
    !cmd.options || cmd.options.every((o) => o.type !== 1 && o.type !== 2);

  if (isFinal) {
    return {
      command: fullName, // Mantém os espaços no nome completo
      description,
      options: optionsSpans,
      optionsDescriptions,
    };
  }

  return null;
}

function getAllFinalCommands(
  commands: Cmd[],
  lang: string,
): Array<{
  command: string;
  description: string;
  options: string;
  optionsDescriptions: string;
}> {
  const finalCommands: Array<{
    command: string;
    description: string;
    options: string;
    optionsDescriptions: string;
  }> = [];

  function processRecursively(cmd: Cmd, parentName = "") {
    const processed = processCommand(cmd, lang, parentName);
    if (processed) {
      finalCommands.push(processed);
    } else if (cmd.options) {
      const currentName = parentName
        ? `${parentName} ${formatName(cmd, lang)}`
        : formatName(cmd, lang);
      cmd.options
        .filter((o) => o.type === 1 || o.type === 2)
        .forEach((o) => processRecursively(o, currentName));
    }
  }

  commands.forEach((cmd) => processRecursively(cmd));
  return finalCommands;
}

const apiLang = t.lang === "pt" ? "pt-BR" : "en-US";
const commands = await getCommands();
const finalCommands = getAllFinalCommands(commands, apiLang);

// Group commands by their root name (first word)
const groupedCommands = finalCommands.reduce(
  (acc, cmd) => {
    const root = cmd.command.split(" ")[0];
    const key = root.charAt(0).toUpperCase() + root.slice(1); // Capitalize
    if (!acc[key]) {
      acc[key] = [];
    }
    acc[key].push(cmd);
    return acc;
  },
  {} as Record<string, typeof finalCommands>,
);

const sortedGroups = Object.keys(groupedCommands).sort();
---

<Layout t={t} title={t.cmds?.title} desc={t.cmds?.seo}>
  <section class="commands-section pt-2 mt-4 mb-5">
    <div class="container">
      <!-- Header -->
      <div class="commands-header text-center mb-5 mt-5">
        <h1 class="display-4 fw-bold text-white mb-3 animate-fade-in">
          <Terminal
            size={40}
            class="me-2 d-inline-block"
            style="color: var(--bs-primary);"
          />
          {t.cmds?.title}
        </h1>
        <p class="lead text-secondary animate-fade-in-delay">{t.cmds?.desc}</p>

        <!-- Search Bar -->
        <div class="search-container mt-4 animate-slide-up">
          <div class="search-wrapper">
            <Search size={20} class="search-icon" />
            <input
              type="text"
              id="commandSearch"
              class="search-input"
              placeholder={t.misc?.search_placeholder ?? "Search commands..."}
              autocomplete="off"
            />
          </div>
        </div>
      </div>

      <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 d-none d-lg-block">
          <div class="sidebar-wrapper animate-slide-up-delay">
            <nav class="sidebar-nav" id="sidebarNav">
              <div class="sidebar-header">
                <Hash size={16} class="me-2" />
                <span>Groups</span>
              </div>
              <ul class="nav flex-column">
                {
                  sortedGroups.map((group) => (
                    <li class="nav-item">
                      <a
                        href={`#group-${group}`}
                        class="nav-link group-link"
                        data-group={group}
                      >
                        <span>{group}</span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill ms-auto">
                          {groupedCommands[group].length}
                        </span>
                        <ChevronRight size={14} class="arrow-icon ms-2" />
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
          <div class="commands-content" id="commandsGrid">
            {
              sortedGroups.map((group, index) => (
                <div
                  class="command-group mb-5 animate-slide-up"
                  style={`animation-delay: ${0.1 * index}s`}
                  id={`group-${group}`}
                  data-group-name={group}
                >
                  <div class="group-header mb-4">
                    <h2 class="group-title">
                      <span class="text-primary">/</span> {group}
                    </h2>
                    <div class="group-divider" />
                  </div>

                  <div class="commands-grid">
                    {groupedCommands[group].map((cmd) => (
                      <CommandCard
                        command={cmd.command}
                        description={cmd.description}
                        options={cmd.options}
                        optionsDescriptions={cmd.optionsDescriptions}
                      />
                    ))}
                  </div>
                </div>
              ))
            }

            <!-- No results message -->
            <div
              id="noResults"
              class="no-results text-center py-5"
              style="display: none;"
            >
              <div class="mb-3">
                <Search size={48} class="text-secondary opacity-50" />
              </div>
              <h3 class="text-white h5">No commands found</h3>
              <p class="text-secondary">Try searching for something else</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    html {
      scroll-padding-top: 120px;
    }

    .commands-section {
      min-height: 70vh;
      position: relative;
    }

    /* Header animations */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fade-in {
      animation: fadeIn 0.8s ease-out;
    }
    .animate-fade-in-delay {
      animation: fadeIn 0.8s ease-out 0.2s both;
    }
    .animate-slide-up {
      animation: slideUp 0.8s ease-out 0.4s both;
    }
    .animate-slide-up-delay {
      animation: slideUp 0.8s ease-out 0.6s both;
    }

    /* Search container */
    .search-container {
      max-width: 800px;
      margin: 0 auto;
    }

    .search-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      color: rgba(255, 255, 255, 0.5);
      z-index: 2;
    }

    .search-input {
      width: 100%;
      padding: 1rem 1rem 1rem 3rem;
      background: rgba(255, 255, 255, 0.08);
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      color: white;
      font-size: 1rem;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
    }

    .search-input::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .search-input:focus {
      outline: none;
      border-color: #f80752;
      background: rgba(248, 7, 82, 0.1);
      box-shadow: 0 0 0 4px rgba(248, 7, 82, 0.2);
    }

    /* Sidebar Navigation */
    .sidebar-wrapper {
      position: sticky;
      top: 100px;
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 1.5rem;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
    }

    .sidebar-wrapper::-webkit-scrollbar {
      width: 4px;
    }

    .sidebar-wrapper::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
    }

    .sidebar-wrapper::-webkit-scrollbar-thumb {
      background: rgba(248, 7, 82, 0.3);
      border-radius: 4px;
    }

    .sidebar-header {
      display: flex;
      align-items: center;
      color: rgba(255, 255, 255, 0.5);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
      margin-bottom: 1rem;
      padding-left: 0.75rem;
    }

    .nav-link {
      display: flex;
      align-items: center;
      color: rgba(255, 255, 255, 0.7);
      padding: 0.75rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      font-weight: 500;
    }

    .nav-link:hover {
      background: rgba(255, 255, 255, 0.05);
      color: white;
      transform: translateX(4px);
    }

    .nav-link.active {
      background: rgba(248, 7, 82, 0.1);
      color: #f80752;
    }

    .nav-link.active .badge {
      background: #f80752 !important;
      color: white !important;
    }

    .arrow-icon {
      opacity: 0;
      transition: all 0.2s ease;
      transform: translateX(-5px);
    }

    .nav-link:hover .arrow-icon,
    .nav-link.active .arrow-icon {
      opacity: 1;
      transform: translateX(0);
    }

    /* Group Headers */
    .group-header {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .group-title {
      margin: 0;
      font-size: 1.75rem;
      font-weight: 700;
      color: white;
      white-space: nowrap;
    }

    .group-divider {
      height: 1px;
      width: 100%;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.1), transparent);
    }

    /* Commands grid */
    .commands-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* No results */
    .no-results {
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.4s ease;
    }

    .no-results.show {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive adjustments */
    @media (max-width: 992px) {
      .sidebar-wrapper {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .commands-header {
        margin-top: 2rem !important;
        margin-bottom: 3rem !important;
      }

      .search-input {
        padding: 0.875rem 0.875rem 0.875rem 2.75rem;
        font-size: 0.95rem;
      }

      .search-icon {
        left: 0.875rem;
        width: 18px;
        height: 18px;
      }
    }
  </style>

  <script is:inline>
    document.addEventListener("astro:page-load", () => {
      const searchInput = document.getElementById("commandSearch");
      const commandsContent = document.getElementById("commandsGrid");
      const noResults = document.getElementById("noResults");
      const sidebarLinks = document.querySelectorAll(".group-link");

      if (!searchInput || !commandsContent || !noResults) return;

      // Filter function
      function filterCommands() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const groups = commandsContent.querySelectorAll(".command-group");
        let totalVisibleCount = 0;

        groups.forEach((group) => {
          const commandCards = group.querySelectorAll(".command-card");
          let groupVisibleCount = 0;

          commandCards.forEach((card) => {
            const commandName =
              card.querySelector(".command-name")?.textContent?.toLowerCase() ||
              "";
            const description =
              card
                .querySelector(".command-description")
                ?.textContent?.toLowerCase() || "";
            const options =
              card
                .querySelector(".command-options")
                ?.textContent?.toLowerCase() || "";
            const optionsDetails =
              card
                .querySelector(".options-details")
                ?.textContent?.toLowerCase() || "";

            const isVisible =
              commandName.includes(searchTerm) ||
              description.includes(searchTerm) ||
              options.includes(searchTerm) ||
              optionsDetails.includes(searchTerm);

            if (isVisible) {
              card.style.display = "";
              groupVisibleCount++;
              totalVisibleCount++;
            } else {
              card.style.display = "none";
            }
          });

          // Toggle group visibility
          const groupName = group.getAttribute("data-group-name");
          const link = document.querySelector(
            `.group-link[data-group="${groupName}"]`,
          );

          if (groupVisibleCount === 0) {
            group.style.display = "none";
            if (link) link.parentElement.style.display = "none";
          } else {
            group.style.display = "";
            if (link) link.parentElement.style.display = "";
          }
        });

        // Toggle no results message
        if (totalVisibleCount === 0 && searchTerm !== "") {
          noResults.style.display = "block";
          requestAnimationFrame(() => noResults.classList.add("show"));
        } else {
          noResults.classList.remove("show");
          setTimeout(() => {
            if (!noResults.classList.contains("show")) {
              noResults.style.display = "none";
            }
          }, 400);
        }
      }

      // Event Listeners
      searchInput.addEventListener("input", filterCommands);

      const handleEscape = (e) => {
        if (e.key === "Escape") {
          searchInput.value = "";
          filterCommands();
          searchInput.blur();
        }
      };
      searchInput.addEventListener("keydown", handleEscape);

      const handleGlobalKeydown = (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === "k") {
          e.preventDefault();
          searchInput.focus();
        }
      };
      document.addEventListener("keydown", handleGlobalKeydown);

      // Scroll Spy
      const observerOptions = {
        root: null,
        rootMargin: "-15% 0px -70% 0px",
        threshold: 0,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            sidebarLinks.forEach((link) => {
              link.classList.remove("active");
              if (link.getAttribute("href") === `#${id}`) {
                link.classList.add("active");
              }
            });
          }
        });
      }, observerOptions);

      document.querySelectorAll(".command-group").forEach((section) => {
        observer.observe(section);
      });

      // Smooth Scroll
      const handleLinkClick = (e) => {
        e.preventDefault();
        const link = e.currentTarget;
        const targetId = link.getAttribute("href");
        if (!targetId || targetId === "#") return;

        const id = targetId.substring(1);
        const targetSection = document.getElementById(id);

        if (targetSection) {
          sidebarLinks.forEach((l) => l.classList.remove("active"));
          link.classList.add("active");

          const headerOffset = 120;
          const elementPosition = targetSection.getBoundingClientRect().top;
          const offsetPosition =
            elementPosition + window.scrollY - headerOffset;

          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      };

      sidebarLinks.forEach((link) => {
        link.addEventListener("click", handleLinkClick);
      });

      // Cleanup function for View Transitions
      const cleanup = () => {
        document.removeEventListener("keydown", handleGlobalKeydown);
        observer.disconnect();
        sidebarLinks.forEach((link) => {
          link.removeEventListener("click", handleLinkClick);
        });
        searchInput.removeEventListener("input", filterCommands);
        searchInput.removeEventListener("keydown", handleEscape);
      };

      document.addEventListener("astro:before-swap", cleanup, { once: true });
    });
  </script>
</Layout>
