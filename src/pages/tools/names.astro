---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT } from '@lib/i18n';
import namesData from '../../../data/names.json';

const t = loadT('en');
const route = '/tools/names';
---
<Layout t={t} route={route} title={t.names?.article?.title} desc={t.names?.article?.desc}>
  <section class="py-4 py-xl-5">
    <div class="container">
      <div class="row row-cols-md-2 d-flex flex-grow-1">
        <div class="col-auto col-sm-12 col-md-6 d-flex align-self-baseline order-first order-md-last">
          <div class="card w-100">
            <div class="card-body p-4">
              <div class="mb-4">
                <label for="gender" class="form-label">Gender</label>
                <select id="gender" class="form-select">
                  <option value="neutral" selected>Neutral</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                </select>
              </div>
              <div class="d-grid">
                <button id="generate" class="btn btn-primary">Generate</button>
              </div>
              <hr />
              <div id="names" class="mt-3"></div>
            </div>
          </div>
        </div>
        <div class="col-auto col-sm-12 col-md-6 d-flex align-self-baseline">
          <div class="text-white">
            <h1 class="display-5 fw-bold text-white">{t.names?.article?.title}</h1>
            <p class="lead text-secondary">{t.names?.article?.desc}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    const source = {data: {male: (namesData as any).male, female: (namesData as any).female}};
    function pick(arr) { return arr[Math.floor(Math.random()*arr.length)]; }
    function gen() {
      const g = (document.getElementById('gender') as HTMLSelectElement).value;
      let pool = [] as string[];
      if (g === 'male') pool = source.data.male; else if (g === 'female') pool = source.data.female; else pool = [...source.data.male, ...source.data.female];
      const out = Array.from({length: 10}).map(() => pick(pool)).join(', ');
      (document.getElementById('names') as HTMLElement).textContent = out;
    }
    document.getElementById('generate')?.addEventListener('click', gen);
  </script>
</Layout>

