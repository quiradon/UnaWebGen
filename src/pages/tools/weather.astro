---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT } from '@lib/i18n';
import { CloudSun, Sliders, Shuffle, Snowflake, CloudRain, Sun, RefreshCw, AlertTriangle, Thermometer, Wind, CloudSnow, CloudLightning, CloudDrizzle, CloudFog, CloudHail, BookOpen, Copy, Check } from '@lucide/astro';

import { getLocale } from "astro-i18n-aut";
const t = loadT(getLocale(Astro.url));
const route = '/tools/weather';
---
<Layout t={t} route={route} title={t.tools?.clima?.pageTitle} desc={t.tools?.clima?.pageDesc}>
  <section class="weather-section pt-2 mt-4 mb-5">
    <div class="container">
      <!-- Header -->
      <div class="col-12 mb-4 text-center">
        <h1 class="display-4 fw-bold text-white mb-3">
          <CloudSun size={40} class="me-2 d-inline-block" style="color: var(--bs-primary);" />
          {t.tools?.clima?.pageTitle}
        </h1>
        <p class="lead text-secondary">{t.tools?.clima?.pageDesc}</p>
      </div>

      <div class="row justify-content-center g-4">
        <!-- Control Panel -->
        <div class="col-lg-5 col-md-12">
          <div class="weather-card glass-card">
            <div class="card-body p-4">
              <h5 class="card-title mb-4 d-flex align-items-center">
                <Sliders size={24} class="me-2" />
                {t.tools?.clima?.select}
              </h5>
              
              <div class="climate-options mb-4">
                <div class="climate-option" data-type="random">
                  <Shuffle size={32} />
                  <span>{t.common?.random}</span>
                </div>
                <div class="climate-option" data-type="cold">
                  <Snowflake size={32} />
                  <span>{t.tools?.clima?.type?.cold}</span>
                </div>
                <div class="climate-option" data-type="temperate">
                  <CloudRain size={32} />
                  <span>{t.tools?.clima?.type?.temperate}</span>
                </div>
                <div class="climate-option" data-type="desert">
                  <Sun size={32} />
                  <span>{t.tools?.clima?.type?.desert}</span>
                </div>
              </div>

              <button class="btn btn-primary btn-lg w-100 generate-btn" id="genWeather">
                <RefreshCw size={20} class="me-2 d-inline-block" />
                {t.tools?.clima?.button}
              </button>
            </div>
          </div>
        </div>

        <!-- Results Panel / Mockup -->
        <div class="col-lg-5 col-md-12">
          <!-- Mockup inicial -->
          <div class="weather-card glass-card mockup-card" id="mockupCard">
            <div class="card-body p-4 d-flex flex-column justify-content-center align-items-center h-100">
              <div class="mockup-icon mb-4">
                <CloudSun size={80} class="opacity-25" />
              </div>
              <h5 class="text-secondary text-center mb-2">Selecione um tipo de clima</h5>
              <p class="text-muted text-center small">Clique em "Gerar Clima" para ver os resultados</p>
            </div>
          </div>

          <!-- Card de resultados -->
          <div class="weather-card glass-card result-card" id="weatherResult" style="display: none;">
            <div class="card-body p-4">
              <div class="weather-icon-container mb-4">
                <div id="weatherIcon"></div>
              </div>
              
              <h3 class="weather-condition mb-4 text-center"></h3>
              
              <div class="weather-details">
                <div class="detail-item">
                  <AlertTriangle size={28} class="detail-icon" />
                  <div class="detail-content">
                    <span class="detail-label">Intensidade</span>
                    <span class="detail-value intensity"></span>
                  </div>
                </div>
                
                <div class="detail-item">
                  <Thermometer size={28} class="detail-icon" />
                  <div class="detail-content">
                    <span class="detail-label temperature-label"></span>
                    <span class="detail-value temperature"></span>
                  </div>
                </div>
                
                <div class="detail-item">
                  <Wind size={28} class="detail-icon" />
                  <div class="detail-content">
                    <span class="detail-label wind-label"></span>
                    <span class="detail-value wind-speed"></span>
                  </div>
                </div>
              </div>

              <!-- Narrative Description for RPG -->
              <div class="narrative-section mt-4">
                <div class="narrative-header" id="narrativeHeader">
                  <BookOpen size={20} class="me-2" />
                  <span>Descrição Narrativa</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron ms-auto"><path d="m6 9 6 6 6-6"/></svg>
                </div>
                <div class="narrative-content" id="narrativeContent">
                  <p class="narrative-text" id="narrativeText"></p>
                  <button class="btn btn-sm btn-outline-primary copy-btn" id="copyNarrative">
                    <Copy size={16} class="me-1" />
                    <span class="copy-text">Copiar</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .weather-section {
      min-height: 70vh;
    }

    .glass-card {
      background: rgba(29, 26, 45, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
      height: 100%;
      min-height: 520px;
    }

    .glass-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    }

    .weather-card .card-body {
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    /* Mockup styles */
    .mockup-card {
      min-height: 520px;
    }

    .mockup-icon {
      opacity: 0.3;
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .climate-options {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      flex-grow: 1;
    }

    .climate-option {
      padding: 20px 16px;
      background: rgba(255, 255, 255, 0.05);
      border: 2px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-align: center;
      min-height: 100px;
    }

    .climate-option :global(svg) {
      color: var(--bs-primary);
      transition: all 0.3s ease;
    }

    .climate-option span {
      font-weight: 500;
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.8);
      transition: all 0.3s ease;
    }

    .climate-option:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--bs-primary);
      transform: scale(1.05);
    }

    .climate-option.active {
      background: linear-gradient(135deg, var(--bs-primary), rgba(248, 7, 82, 0.6));
      border-color: var(--bs-primary);
      box-shadow: 0 4px 16px rgba(248, 7, 82, 0.4);
    }

    .climate-option.active :global(svg) {
      color: white !important;
      transform: scale(1.15);
      filter: drop-shadow(0 2px 8px rgba(255, 255, 255, 0.3));
    }

    .climate-option.active span {
      color: white;
      font-weight: 600;
    }

    .generate-btn {
      padding: 16px;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 12px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .generate-btn::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      transform: translate(-50%, -50%);
      transition: width 0.6s, height 0.6s;
    }

    .generate-btn:hover::before {
      width: 300px;
      height: 300px;
    }

    .generate-btn:active {
      transform: scale(0.96);
    }

    .generate-btn:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .result-card {
      animation: slideInUp 0.5s ease-out;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .weather-icon-container {
      text-align: center;
      padding: 30px 20px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
      border-radius: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .weather-icon-container :global(svg) {
      animation: iconPulse 2s ease-in-out infinite;
    }

    @keyframes iconPulse {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.1);
      }
    }

    @keyframes spin {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    .generate-btn.loading :global(svg) {
      animation: spin 1s linear infinite;
    }

    .weather-condition {
      font-size: 1.8rem;
      font-weight: 700;
      background: linear-gradient(135deg, var(--bs-primary), #ff6b9d);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .weather-details {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .detail-item {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .detail-item:hover {
      background: rgba(255, 255, 255, 0.08);
      transform: translateX(4px);
    }

    .detail-item :global(.detail-icon) {
      color: var(--bs-primary);
      min-width: 28px;
      flex-shrink: 0;
    }

    .detail-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .detail-label {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.6);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .detail-value {
      font-size: 1.2rem;
      font-weight: 600;
      color: white;
    }

    /* Responsividade mobile */
    @media (max-width: 991px) {
      .glass-card {
        min-height: auto;
      }

      .mockup-card {
        min-height: 300px;
      }

      .climate-options {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .climate-option {
        padding: 16px 12px;
        min-height: 90px;
      }

      .climate-option span {
        font-size: 0.85rem;
      }
    }

    @media (max-width: 576px) {
      .climate-options {
        grid-template-columns: 1fr;
      }

      .climate-option {
        flex-direction: row;
        justify-content: flex-start;
        min-height: 70px;
        padding: 16px;
      }

      .climate-option :global(svg) {
        width: 28px;
        height: 28px;
      }

      .weather-icon-container {
        padding: 20px;
      }

      .weather-condition {
        font-size: 1.5rem;
      }

      .detail-item {
        padding: 12px;
      }

      .detail-value {
        font-size: 1.1rem;
      }
    }

    /* Narrative Section */
    .narrative-section {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding-top: 16px;
    }

    .narrative-header {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      user-select: none;
    }

    .narrative-header:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .narrative-header span {
      font-weight: 600;
      color: rgba(255, 255, 255, 0.9);
      font-size: 1rem;
    }

    .narrative-header .chevron {
      transition: transform 0.3s ease;
      color: var(--bs-primary);
    }

    .narrative-header.expanded .chevron {
      transform: rotate(180deg);
    }

    .narrative-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease, padding 0.4s ease;
      padding: 0 16px;
    }

    .narrative-content.expanded {
      max-height: 500px;
      padding: 16px;
    }

    .narrative-text {
      margin: 0 0 16px 0;
      line-height: 1.8;
      color: rgba(255, 255, 255, 0.85);
      font-size: 0.95rem;
      font-style: italic;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
      padding: 16px;
      border-radius: 12px;
      border-left: 3px solid var(--bs-primary);
    }

    .copy-btn {
      display: flex;
      align-items: center;
      gap: 4px;
      transition: all 0.3s ease;
      border-radius: 8px;
      padding: 8px 16px;
    }

    .copy-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(248, 7, 82, 0.3);
    }

    .copy-btn.copied {
      background: rgba(34, 197, 94, 0.2);
      border-color: #22c55e;
      color: #22c55e;
    }

    /* Weather type specific colors */
    .weather-cold { color: #66b3ff; }
    .weather-temperate { color: #6ec9ff; }
    .weather-desert { color: #ffb347; }
    .weather-snow { color: #e0f2ff; }
    .weather-rain { color: #5ba3d0; }
    .weather-clear { color: #ffd700; }
    .weather-storm { color: #9370db; }
  </style>

  <script define:vars={{ climaTranslations: t.tools.clima }} is:inline>
    // Weather icon SVG mapping (Lucide-style)
    const weatherIconsSVG = {
      'blizzard': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 9a3 3 0 1 0 0 6"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="m9 18 3 3 3-3"/><path d="m9 6 3-3 3 3"/><path d="m15 18 3 3 3-3"/><path d="m15 6 3-3 3 3"/></svg>',
      'snow': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/><path d="M16 14v2"/><path d="M8 14v2"/><path d="M16 20v2"/><path d="M8 20v2"/><path d="M12 16v2"/><path d="M12 22v2"/></svg>',
      'cloudy': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>',
      'clear': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>',
      'thunderstorm': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 16.326A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 .5 8.973"/><path d="m13 12-3 5h4l-3 5"/></svg>',
      'heavy_rain': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M8 19v1"/><path d="M8 14v1"/><path d="M16 19v1"/><path d="M16 14v1"/><path d="M12 21v1"/><path d="M12 16v1"/></svg>',
      'light_rain': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M8 19v2"/><path d="M12 19v2"/><path d="M16 19v2"/></svg>',
      'sandstorm': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5.2 6.2 1.4 1.4"/><path d="M2 13h2"/><path d="M20 13h2"/><path d="m17.4 7.6 1.4-1.4"/><path d="M22 17H2"/><path d="M22 21H2"/><path d="M16 13a4 4 0 0 0-8 0"/><path d="M12 5V2.5"/></svg>',
      'dust_devil': '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4H3"/><path d="M18 8H6"/><path d="M19 12H9"/><path d="M16 16h-6"/><path d="M11 20H9"/></svg>'
    };

    const weatherColors = {
      'blizzard': '#66b3ff',
      'snow': '#e0f2ff',
      'cloudy': '#a8b8c8',
      'clear': '#ffd700',
      'thunderstorm': '#9370db',
      'heavy_rain': '#4a90e2',
      'light_rain': '#6ec9ff',
      'sandstorm': '#d4a574',
      'dust_devil': '#c89b6f'
    };

    // RPG Narrative Templates
    const narrativeTemplates = {
      // Blizzard narratives
      'blizzard_severe': [
        'O vento uiva com uma fúria implacável, lançando cristais de gelo como lâminas afiadas. A visibilidade é quase nula, e cada passo é uma batalha contra a natureza. Qualquer pele exposta ao frio cortante sofre danos rapidamente. Os aventureiros devem encontrar abrigo urgentemente ou arriscam sucumbir ao abraço mortal do inverno.',
        'Uma muralha branca de neve e gelo avança como uma criatura viva, engolindo tudo em seu caminho. O ar é tão frio que queima os pulmões a cada respiração. Sons distantes ecoam de forma distorcida, criando uma sensação de desorientação absoluta. Apenas os mais preparados sobreviverão a esta provação ártica.',
        'A tempestade de neve rugindo ao redor parece ter vida própria, como se espíritos ancestrais do inverno dançassem em fúria. O frio penetra até os ossos, e os flocos congelados chicoteiam a pele sem piedade. Mesmo o fogo hesita em se manter aceso contra tal adversidade.'
      ],
      'blizzard_moderate': [
        'Flocos de neve densos caem incessantemente, reduzindo a visibilidade a poucos metros. O vento frio corta através das roupas, e o chão está coberto por uma espessa camada de neve que dificulta a movimentação. É prudente buscar abrigo antes que as condições piorem.',
        'Uma nevasca constante transforma a paisagem em um mar branco uniforme. O vento geme baixo entre as árvores, depositando neve em cada superfície. Manter-se aquecido requer esforço constante, e o grupo deve trabalhar junto para conservar energia e calor.'
      ],
      'blizzard_mild': [
        'Neve fina dança no ar frio, trazida por rajadas de vento ocasionais. Embora o clima seja desafiador, ainda é possível viajar com cuidado. A paisagem adquire uma beleza etérea, apesar do desconforto do frio penetrante.',
        'O ar gelado traz consigo flocos de neve que se depositam suavemente, criando um manto branco sobre tudo. O frio é intenso, mas manejável com o equipamento adequado. A jornada continua, embora a prudência seja necessária.'
      ],

      // Snow narratives
      'snow_severe': [
        'A neve cai em torrentes espessas, acumulando-se rapidamente e transformando o terreno em um desafio mortal. Cada passo afunda profundamente, exaurindo a força dos viajantes. A temperatura despenca, e o risco de hipotermia é real e iminente.',
        'Pesados flocos de neve caem sem pausa, criando um silêncio opressivo quebrado apenas pelo ranger da neve sob os pés. A acumulação rápida ameaça cobrir caminhos e referências, tornando impossível seguir em frente sem extremo cuidado.'
      ],
      'snow_moderate': [
        'Neve constante cai do céu cinza, cobrindo o mundo em um cobertor branco. O avanço é lento mas possível, e abrigos temporários podem ser erguidos com relativa facilidade. A beleza do inverno compete com seu perigo.',
        'Flocos grandes e úmidos descem suavemente, criando uma atmosfera quase pacífica. No entanto, a temperatura baixa exige atenção constante, e o grupo deve manter-se em movimento para evitar o frio que insidiosamente rouba o calor corporal.'
      ],
      'snow_mild': [
        'Neve leve cai delicadamente, pontilhando o ar com cristais brilhantes. O cenário é de rara beleza, embora o frio ainda demande respeito. É possível apreciar a jornada enquanto se mantém vigilante.',
        'Pequenos flocos flutuam preguiçosamente do céu, adicionando uma camada fina ao solo já coberto de branco. O ar é fresco e revigorante, e o grupo pode continuar sua jornada com cuidado moderado.'
      ],

      // Cloudy narratives  
      'cloudy_severe': [
        'Nuvens densas e escuras cobrem completamente o céu, criando uma penumbra antinatural mesmo durante o dia. O ar está pesado e úmido, prenunciando uma possível tempestade. Uma sensação de inquietação permeia o ambiente.',
        'O céu está completamente coberto por camadas espessas de nuvens cinzentas que bloqueiam qualquer raio de sol. A atmosfera é opressiva, e há uma estranha qualidade no ar que deixa todos em alerta.'
      ],
      'cloudy_moderate': [
        'Nuvens cinzentas dominam o céu, ocasionalmente permitindo que raios difusos de luz filtrem através. O clima é fresco e a iluminação natural é reduzida, criando longas sombras mesmo ao meio-dia.',
        'Uma cobertura contínua de nuvens transforma o dia em uma série de tons de cinza. A luz é difusa mas adequada para viajar, embora o humor geral seja mais sombrio e contemplativo.'
      ],
      'cloudy_mild': [
