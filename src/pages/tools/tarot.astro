---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT } from '@lib/i18n';

const t = loadT('en');
const route = '/tools/tarot';
---
<Layout t={t} route={route} title={t.tarot?.title} desc={t.tarot?.desc}>
  <section class="justify-content-lg-center pt-2 mt-4 mb-4">
    <div class="container">
      <div class="row g-0 d-flex justify-content-center">
        <div class="col-10 col-md-5 order-first order-md-last">
          <img class="img-fluid p-5 w-100 h-100 fit-cover CardPoker" id="cardshow" src="/static/api/tarot-card/20.webp" loading="lazy" alt="Random Tarot card" />
        </div>
        <div class="col d-flex justify-content-center align-items-center align-content-center order-last">
          <div class="text-white">
            <h1 class="display-5 fw-bold text-white">{t.tarot?.title}</h1>
            <p class="lead text-secondary">{t.tarot?.desc}</p>
            <div class="input-group">
              <button class="text-wrap btn btn-primary link-light p-2" id="cardsrun" style="white-space: nowrap;" type="button">{t.misc?.btn?.gencard}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const audio = "/static/audio/play-card.mp3";
    (document.getElementById('cardsrun') as HTMLButtonElement).onclick = card;
    function card() {
      const audioElement = new Audio(audio);
      audioElement.volume = 0.5;
      audioElement.play();
      const cardNumber = Math.floor(22 * Math.random());
      const cardimg = `/static/api/tarot-card/${cardNumber}.webp`;
      const cardElement = document.getElementById('cardshow') as HTMLImageElement;
      cardElement.src = cardimg;
      cardElement.classList.add('flip');
      setTimeout(() => { cardElement.classList.remove('flip'); }, 500);
    }
  </script>
</Layout>

