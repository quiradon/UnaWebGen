---
import Header from "./base/Header.astro";
import Body from "./base/Body.astro";
import ImageUploader from "@/components/dashboard/ImageUploader";

interface Props {
  modalId?: string;
  apiBase: string;
}

const { modalId = "uploadImageModal", apiBase } = Astro.props;
---

<div
  id={modalId}
  class="modal fade upload-image-modal"
  role="dialog"
  tabindex="-1"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content">
      <Header title="Enviar Nova Imagem" intro="Escolha uma imagem abaixo para enviar para sua galeria." />
      <Body>
         <ImageUploader client:only="react" apiBase={apiBase} />
      </Body>
      <div class="p-3"></div>
    </div>
  </div>
</div>

<style is:global>
  .upload-image-modal {
    z-index: 1060 !important;
    background: rgba(0, 0, 0, 0.8);
  }

  .upload-image-modal .modal-dialog {
    z-index: 1061 !important;
  }

  .upload-image-modal .modal-content {
    background: #0f1219;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    max-height: 90dvh;
    z-index: 1062 !important;
  }

  .upload-image-modal .modal-dialog {
    max-width: 880px;
  }

  @media (max-width: 992px) {
    .upload-image-modal .modal-dialog {
      max-width: 680px;
      margin: 1.25rem auto;
    }
  }

  @media (max-width: 576px) {
    .upload-image-modal .modal-dialog {
      margin: 0;
      width: 100%;
      max-width: 100%;
      height: 100vh;
      height: 100dvh;
    }

    .upload-image-modal .modal-content {
      height: 100%;
      max-height: 100vh;
      max-height: 100dvh;
      border-radius: 0;
    }
  }
</style>

<script>
  function initUploadModal() {
    const modalEl = document.getElementById('uploadImageModal');
    if (!modalEl) return;

    // Interceptar cliques no botão que abre o modal
    const triggerBtn = document.querySelector('[data-bs-target="#uploadImageModal"]');
    if (triggerBtn && !triggerBtn.hasAttribute('data-upload-modal-init')) {
      triggerBtn.setAttribute('data-upload-modal-init', 'true');
      
      triggerBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const bootstrap = (window as any).bootstrap;
        if (bootstrap && bootstrap.Modal) {
          const modalInstance = new bootstrap.Modal(modalEl, {
            backdrop: false
          });
          modalInstance.show();
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initUploadModal);
  document.addEventListener('astro:page-load', initUploadModal);
</script>
