---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { loadT, getStaticPaths } from '@lib/i18n';
export { getStaticPaths };
const lang = Astro.params.locales as string;
const t = loadT(lang);
const route = '/tools/tarot';
---
<Layout t={t} route={route} title={t.tarot?.title} desc={t.tarot?.desc}>
  <section class="justify-content-lg-center pt-2 mt-4 mb-4">
    <div class="container">
      <div class="row g-0 d-flex justify-content-center">
        <div class="col-10 col-md-5 order-first order-md-last">
          <img class="img-fluid p-5 w-100 h-100 fit-cover CardPoker" id="cardshow" src="/static/api/tarot-card/20.webp" loading="lazy" alt="Random Tarot card" />
        </div>
        <div class="col-12 col-md-7 d-flex justify-content-center align-items-center align-content-center order-last p-4">
          <div class="text-white">
            <h1 class="display-5 fw-bold text-white">{t.tarot?.article?.title}</h1>
            <p class="lead text-secondary">{t.tarot?.article?.desc}</p>
            <div class="d-lg-flex justify-content-lg-start align-items-lg-center">
              <button class="btn btn-primary btn-lg link-light m-2 ms-0" id="cardsrun" type="button">{t.misc?.btn?.gencard}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    const audio = "/static/audio/play-card.mp3";
    const cardsrun = document.getElementById('cardsrun');
    const cardshow = document.getElementById('cardshow');
    cardsrun.addEventListener('click', () => {
      const audioElement = new Audio(audio);
      audioElement.volume = 0.5;
      audioElement.play();
      const randomCard = Math.floor(Math.random() * 22);
      cardshow.src = '/static/api/tarot-card/' + randomCard + '.webp';
      cardshow.classList.add('flip');
      setTimeout(() => cardshow.classList.remove('flip'), 300);
    });
  </script>
</Layout>
