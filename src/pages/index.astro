            <p>{t.premium?.[1]?.desc}</p>
            <ul class="list-unstyled justify-content-xxl-start mb-1">
              <li class="mb-1"><User size={16} class="d-inline me-1" /> {t.premium?.feat?.[10]}</li>
              <li class="mb-1"><Coins size={16} class="d-inline me-1" /> 4 {t.premium?.feat?.[4]}</li>
              <li class="mb-1"><Key size={16} class="d-inline me-1" /> {t.premium?.feat?.[6]} {t.premium?.feat?.[8]}</li>
              <li class="mb-1"><MessageCircle size={16} class="d-inline me-1" /> {t.premium?.feat?.[5]}</li>
              <li><hr /></li>
              <li class="mb-1"><Dices size={16} class="d-inline me-1" /> {t.premium?.feat?.[0]}</li>
              <li class="mb-1"><Tags size={16} class="d-inline me-1" /> {t.premium?.feat?.[1]}</li>
              <li class="mb-1"><BookText size={16} class="d-inline me-1" /> {t.premium?.feat?.[2]}</li>
              <li class="mb-1"><Palette size={16} class="d-inline me-1" /> {t.premium?.feat?.[3]}</li>
            </ul>
            <h4 id="price-1" class="mt-3">{t.price?.[1]}</h4>
