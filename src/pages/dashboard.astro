---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getLocale } from "astro-i18n-aut";
import { loadT } from '@lib/i18n';
import config from '../config.json';
import { User, BookText } from '@lucide/astro';

const t = loadT(getLocale(Astro.url));
const apiBase = (config.api_url ?? 'https://una-api.arkanus.app').replace(/\/$/, '');
---

<Layout t={t} title="Dashboard">
  <style>
    .dashboard-section {
      min-height: 80vh;
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .user-profile-card {
      background: rgba(29, 26, 45, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .user-profile-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(248, 7, 82, 0.05), rgba(248, 7, 82, 0.02));
      pointer-events: none;
    }

    .avatar-container {
      position: relative;
      width: 120px;
      height: 120px;
      margin: 0 auto;
    }

    .avatar-ring {
      position: absolute;
      top: -4px;
      left: -4px;
      right: -4px;
      bottom: -4px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--bs-primary), rgba(248, 7, 82, 0.5));
      animation: pulse-ring 2s ease-in-out infinite;
    }

    @keyframes pulse-ring {
      0%, 100% { opacity: 0.7; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.05); }
    }

    .avatar-img {
      position: relative;
      z-index: 1;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 4px solid rgba(20, 20, 30, 0.9);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    }

    .user-info-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      transition: all 0.3s ease;
    }

    .user-info-item:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(248, 7, 82, 0.2);
      transform: translateX(4px);
    }

    .info-label {
      font-size: 0.85rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.6);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.25rem;
    }

    .info-value {
      font-size: 1.1rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.95);
    }

    /* Tool card style */
    .tool-card {
      background: rgba(29, 26, 45, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      min-height: 240px;
      text-decoration: none;
      display: block;
    }

    .tool-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(135deg, rgba(248, 7, 82, 0.1), rgba(248, 7, 82, 0.05));
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .tool-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
      border-color: rgba(248, 7, 82, 0.3);
    }

    .tool-card:hover::before {
      opacity: 1;
    }

    .icon-container {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 16px;
      transition: all 0.3s ease;
      position: relative;
    }

    .tool-card:hover .icon-container {
      background: rgba(255, 255, 255, 0.1);
      transform: scale(1.1);
    }

    .tool-icon {
      transition: all 0.3s ease;
    }

    .tool-card:hover .tool-icon {
      transform: scale(1.1);
      filter: drop-shadow(0 2px 8px rgba(248, 7, 82, 0.3));
    }

    .card-footer-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      opacity: 0;
      transform: translateX(-10px);
      transition: all 0.3s ease;
      color: var(--bs-primary);
      font-size: 0.9rem;
      font-weight: 500;
    }

    .tool-card:hover .card-footer-indicator {
      opacity: 1;
      transform: translateX(0);
    }

    .arrow-icon {
      transition: transform 0.3s ease;
    }

    .tool-card:hover .arrow-icon {
      transform: translateX(4px);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-in-up {
      animation: fadeInUp 0.6s ease-out;
    }
  </style>

  <!-- Loading State -->
  <div id="loading-state" class="dashboard-section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 text-center">
          <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Carregando...</span>
          </div>
          <p class="mt-3 text-secondary">Verificando autenticação...</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Content (hidden by default) -->
  <section id="dashboard-content" class="dashboard-section" style="display: none;">
    <div class="container">
      <div class="row g-4">
        <!-- User Profile Card -->
        <div class="col-lg-6 fade-in-up">
          <div class="user-profile-card p-4 h-100">
            <div class="text-center mb-4">
              <div class="avatar-container">
                <div class="avatar-ring"></div>
                <img 
                  id="user-avatar"
                  src="" 
                  alt="User Avatar"
                  class="avatar-img"
                />
              </div>
              <h3 class="text-white mt-3 mb-1" id="user-display-name">-</h3>
              <p class="text-secondary mb-0" id="user-username-display">@-</p>
            </div>

            <div class="row g-3">
              <div class="col-12">
                <div class="user-info-item">
                  <div class="info-label">Usuário Discord</div>
                  <div class="info-value" id="user-username">-</div>
                </div>
              </div>

              <div class="col-12">
                <div class="user-info-item">
                  <div class="info-label">ID Discord</div>
                  <div class="info-value" id="user-id">-</div>
                </div>
              </div>
            </div>

            <div class="text-center mt-4">
              <button 
                id="logout-btn"
                class="btn btn-outline-danger fw-bold w-100"
              >
                Sair da Conta
              </button>
            </div>
          </div>
        </div>

        <!-- Sheets Card -->
        <div class="col-lg-6 fade-in-up" style="animation-delay: 0.1s;">
          <a href="/tools" class="tool-card">
            <div class="card-body p-4 h-100 d-flex flex-column">
              <div class="icon-container mb-3">
                <BookText size={32} class="tool-icon text-primary" />
              </div>
              <h4 class="card-title text-white mb-2">Consultar Fichas Antigas</h4>
              <p class="card-text text-secondary flex-grow-1">
                Acesse e visualize suas fichas de personagens antigas. Explore seu histórico de aventuras e personagens memoráveis.
              </p>
              <div class="card-footer-indicator mt-auto">
                <span class="explore-text">Explorar</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
                  <path d="M5 12h14"/>
                  <path d="m12 5 7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    (async function() {
      const loadingState = document.getElementById('loading-state');
      const dashboardContent = document.getElementById('dashboard-content');

      try {
        // Verificar sessão
        const response = await fetch(`${apiBase}/auth/session`, {
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
          },
        });

        if (!response.ok) {
          throw new Error('Failed to fetch session');
        }

        const sessionData = await response.json();

        // Se não estiver autenticado, redirecionar para home
        if (!sessionData.authenticated || !sessionData.user) {
          window.location.href = '/';
          return;
        }

        // Preencher dados do usuário
        const user = sessionData.user;
        
        const avatarImg = document.getElementById('user-avatar');
        const displayNameEl = document.getElementById('user-display-name');
        const usernameEl = document.getElementById('user-username');
        const userIdEl = document.getElementById('user-id');

        if (avatarImg) {
          avatarImg.src = user.avatar_url || '';
          avatarImg.alt = user.display_name || 'User Avatar';
        }
        
        const displayName = user.display_name || user.username || 'Discord User';
        const username = user.username || 'unknown';
        
        if (displayNameEl) displayNameEl.textContent = displayName;
        
        const usernameDisplayEl = document.getElementById('user-username-display');
        if (usernameDisplayEl) usernameDisplayEl.textContent = '@' + username;
        
        if (usernameEl) usernameEl.textContent = username;
        if (userIdEl) userIdEl.textContent = user.id || '-';

        // Mostrar dashboard
        if (loadingState) loadingState.style.display = 'none';
        if (dashboardContent) dashboardContent.style.display = 'block';

      } catch (error) {
        console.error('Failed to load dashboard:', error);
        // Em caso de erro, redirecionar para home
        window.location.href = '/';
      }
    })();

    // Handler de logout
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      try {
        await fetch(`${apiBase}/auth/logout`, {
          method: 'POST',
          credentials: 'include',
        });
        
        try { 
          sessionStorage.removeItem('kraken_session_present'); 
        } catch {}
        
        window.location.href = '/';
      } catch (error) {
        console.error('Failed to logout', error);
        window.location.href = '/';
      }
    });
  </script>
</Layout>
