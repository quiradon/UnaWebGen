---
import { BookText, FileText, HardDrive } from "@lucide/astro";
import ToolCard from "@components/ToolCard.astro";
import UserProfileCard from "./UserProfileCard.astro";
import QuickStatsCard from "./QuickStatsCard.astro";

interface Props {
  t: any;
  langPrefix: string;
}

const { t, langPrefix } = Astro.props;

const hrefOldSheets = langPrefix
  ? `${langPrefix}/dashboard/old/characters/`
  : "/dashboard/old/characters/";

const hrefFiles = langPrefix
  ? `${langPrefix}/dashboard/files/`
  : "/dashboard/files/";

const hrefHandoutBuilder = langPrefix
  ? `${langPrefix}/dashboard/handout-builder/`
  : "/dashboard/handout-builder/";

const toolCards = [
  {
    href: hrefOldSheets,
    title: t.Dashbaord.actions.old.title,
    description: t.Dashbaord.actions.old.description,
    Icon: BookText,
  },
  {
    href: hrefFiles,
    title: t.Dashbaord.actions.files.title,
    description: t.Dashbaord.actions.files.description,
    Icon: HardDrive,
  },
  {
    href: hrefHandoutBuilder,
    title: t.Dashbaord.actions.handout.title,
    description: t.Dashbaord.actions.handout.description,
    Icon: FileText,
  },
];
---

<section id="dashboard-content" class="dashboard-section">
  <div class="container">
    <div class="row g-4">
      <!-- User Profile Card -->
      <div class="col-lg-6 col-xl-6 fade-in-up">
        <UserProfileCard t={t} />
      </div>

      <!-- Tool Cards -->
      {
        toolCards.map((card, index) => (
          <div
            class="col-lg-6 col-xl-6 fade-in-up"
            style={`animation-delay: ${(index + 1) * 0.1}s;`}
          >
            <ToolCard
              href={card.href}
              title={card.title}
              description={card.description}
              exploreText={t.Dashbaord.actions.explore}
              hoverLift={true}
            >
              <card.Icon size={32} class="tool-icon text-primary" />
            </ToolCard>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dashboard-section {
    min-height: 80vh;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.6s ease-out;
  }
</style>
