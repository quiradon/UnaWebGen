---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import { getLocale } from "astro-i18n-aut";
import { loadT } from '@lib/i18n';
import config from '../config.json';

const t = loadT(getLocale(Astro.url));
const apiBase = (config.api_url ?? 'https://una-api.arkanus.app').replace(/\/$/, '');
---

<Layout t={t} title="Dashboard">
  <style>
    .vintage-card {
      background: linear-gradient(135deg, #f5f0e8 0%, #e8dcc8 100%);
      border: 3px solid #8b7355;
      border-radius: 10px;
      box-shadow: 
        0 8px 16px rgba(0, 0, 0, 0.3),
        inset 0 0 20px rgba(139, 115, 85, 0.1),
        0 0 0 1px rgba(255, 255, 255, 0.2) inset;
      position: relative;
      overflow: hidden;
    }

    .vintage-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: 
        repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(139, 115, 85, 0.03) 2px,
          rgba(139, 115, 85, 0.03) 4px
        );
      pointer-events: none;
    }

    .vintage-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(ellipse at center, transparent 0%, rgba(101, 67, 33, 0.05) 100%);
      pointer-events: none;
    }

    .vintage-header {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-weight: bold;
      color: #5a4a3a;
      text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.5);
      letter-spacing: 2px;
      border-bottom: 2px solid #8b7355;
      position: relative;
      z-index: 1;
    }

    .vintage-content {
      position: relative;
      z-index: 1;
      color: #4a3a2a;
    }

    .vintage-label {
      font-family: 'Georgia', 'Times New Roman', serif;
      font-weight: 600;
      color: #6a5a4a;
      font-size: 0.9rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .vintage-value {
      font-family: 'Courier New', monospace;
      color: #3a2a1a;
      font-size: 1.1rem;
      font-weight: 500;
    }

    .vintage-ornament {
      color: #8b7355;
      opacity: 0.6;
      font-size: 1.5rem;
    }

    .paper-texture {
      background-image: 
        url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='2' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
      background-size: 200px 200px;
    }

    .stamp-effect {
      position: relative;
      display: inline-block;
    }

    .stamp-effect::before {
      content: '✓';
      position: absolute;
      top: -10px;
      right: -10px;
      background: rgba(139, 69, 19, 0.1);
      border: 2px solid #8b4513;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #8b4513;
      font-weight: bold;
      transform: rotate(15deg);
    }

    .hero-bg {
      background: url('/img/bg/pattern-square.svg') top / auto repeat-x;
    }
  </style>

  <!-- Loading State -->
  <div id="loading-state" class="hero-bg py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 text-center">
          <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Carregando...</span>
          </div>
          <p class="mt-3 text-secondary">Verificando autenticação...</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dashboard Content (hidden by default) -->
  <section id="dashboard-content" class="hero-bg py-5" style="display: none;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
          <!-- Vintage Card -->
          <div class="vintage-card paper-texture p-4 p-md-5 my-4">
            <div class="vintage-header text-center pb-3 mb-4">
              <span class="vintage-ornament">⚜</span>
              <h1 class="d-inline mx-3 mb-0">DASHBOARD</h1>
              <span class="vintage-ornament">⚜</span>
            </div>

            <div class="vintage-content">
              <!-- User Avatar Section -->
              <div class="text-center mb-4">
                <div class="stamp-effect d-inline-block">
                  <img 
                    id="user-avatar"
                    src="" 
                    alt="User Avatar"
                    class="rounded-circle border border-3 border-dark"
                    width="120"
                    height="120"
                    style="box-shadow: 0 4px 8px rgba(0,0,0,0.3);"
                  />
                </div>
              </div>

              <!-- User Information -->
              <div class="row g-3">
                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center border-bottom border-2 pb-2 mb-2" style="border-color: rgba(139, 115, 85, 0.3) !important;">
                    <span class="vintage-label">Nome:</span>
                    <span class="vintage-value" id="user-display-name">-</span>
                  </div>
                </div>

                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center border-bottom border-2 pb-2 mb-2" style="border-color: rgba(139, 115, 85, 0.3) !important;">
                    <span class="vintage-label">Usuário:</span>
                    <span class="vintage-value" id="user-username">-</span>
                  </div>
                </div>

                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center border-bottom border-2 pb-2 mb-2" style="border-color: rgba(139, 115, 85, 0.3) !important;">
                    <span class="vintage-label">ID Discord:</span>
                    <span class="vintage-value" id="user-id">-</span>
                  </div>
                </div>
              </div>

              <!-- Ornamental Footer -->
              <div class="text-center mt-5 pt-4" style="border-top: 2px solid #8b7355;">
                <p class="vintage-label mb-0" style="opacity: 0.7;">
                  ⚔ Bem-vindo ao Mini Kraken RPG ⚔
                </p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="text-center mt-4">
            <a href="/" class="btn btn-outline-primary me-2 fw-bold">
              ← Voltar para Home
            </a>
            <button 
              id="logout-btn"
              class="btn btn-outline-danger fw-bold"
            >
              Sair
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ apiBase }}>
    (async function() {
      const loadingState = document.getElementById('loading-state');
      const dashboardContent = document.getElementById('dashboard-content');

      try {
        // Verificar sessão
        const response = await fetch(`${apiBase}/auth/session`, {
          credentials: 'include',
          headers: {
            'Accept': 'application/json',
          },
        });

        if (!response.ok) {
          throw new Error('Failed to fetch session');
        }

        const sessionData = await response.json();

        // Se não estiver autenticado, redirecionar para home
        if (!sessionData.authenticated || !sessionData.user) {
          window.location.href = '/';
          return;
        }

        // Preencher dados do usuário
        const user = sessionData.user;
        
        const avatarImg = document.getElementById('user-avatar');
        const displayNameEl = document.getElementById('user-display-name');
        const usernameEl = document.getElementById('user-username');
        const userIdEl = document.getElementById('user-id');

        if (avatarImg) {
          avatarImg.src = user.avatar_url || '';
          avatarImg.alt = user.display_name || 'User Avatar';
        }
        
        if (displayNameEl) displayNameEl.textContent = user.display_name || user.username || 'Discord User';
        if (usernameEl) usernameEl.textContent = '@' + (user.username || 'unknown');
        if (userIdEl) userIdEl.textContent = user.id || '-';

        // Mostrar dashboard
        if (loadingState) loadingState.style.display = 'none';
        if (dashboardContent) dashboardContent.style.display = 'block';

      } catch (error) {
        console.error('Failed to load dashboard:', error);
        // Em caso de erro, redirecionar para home
        window.location.href = '/';
      }
    })();

    // Handler de logout
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      try {
        await fetch(`${apiBase}/auth/logout`, {
          method: 'POST',
          credentials: 'include',
        });
        
        try { 
          sessionStorage.removeItem('kraken_session_present'); 
        } catch {}
        
        window.location.href = '/';
      } catch (error) {
        console.error('Failed to logout', error);
        window.location.href = '/';
      }
    });
  </script>
</Layout>
