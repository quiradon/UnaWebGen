---
import GlassCard from "@components/ui-astro/GlassCard.astro";

interface Props {
  href?: string;
  title: string;
  description: string;
  icon: any;
  exploreText?: string;
  class?: string;
}

const {
  href,
  title,
  description,
  icon: Icon,
  exploreText,
  class: className,
} = Astro.props;

const CardElement = href ? "a" : "div";
const cardProps = href
  ? {
      href,
      class: `dashboard-card text-decoration-none d-block ${className ?? ""}`,
    }
  : {
      class: `dashboard-card ${className ?? ""}`,
    };
---

<GlassCard as={CardElement} {...cardProps}>
  <div class="dashboard-card__content p-3">
    <div class="dashboard-card__icon">
      <Icon size={24} />
    </div>
    <div class="dashboard-card__body">
      <h4 class="dashboard-card__title">{title}</h4>
      <p class="dashboard-card__description">{description}</p>
      {
        exploreText && href && (
          <div class="dashboard-card__footer">
            <span class="dashboard-card__explore">{exploreText}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="dashboard-card__arrow"
            >
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </div>
        )
      }
    </div>
  </div>
</GlassCard>

<style>
  .dashboard-card {
    position: relative;
    transition: all 0.3s ease;
  }

  .dashboard-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(248, 7, 82, 0.05),
      rgba(248, 7, 82, 0.02)
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: inherit;
  }

  .dashboard-card:hover {
    border-color: rgba(248, 7, 82, 0.2);
  }

  .dashboard-card:hover::before {
    opacity: 1;
  }

  .dashboard-card__content {
    display: flex;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .dashboard-card__icon {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.25rem;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(248, 7, 82, 0.1);
    color: var(--bs-primary);
    transition: all 0.3s ease;
  }

  .dashboard-card:hover .dashboard-card__icon {
    background: rgba(248, 7, 82, 0.15);
    transform: scale(1.05);
  }

  .dashboard-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .dashboard-card__title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .dashboard-card:hover .dashboard-card__title {
    color: rgba(255, 255, 255, 1);
  }

  .dashboard-card__description {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .dashboard-card:hover .dashboard-card__description {
    color: rgba(255, 255, 255, 0.75);
  }

  .dashboard-card__footer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 0.5rem;
    opacity: 0;
    transform: translateX(-8px);
    transition: all 0.3s ease;
    color: var(--bs-primary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .dashboard-card:hover .dashboard-card__footer {
    opacity: 1;
    transform: translateX(0);
  }

  .dashboard-card__arrow {
    transition: transform 0.3s ease;
  }

  .dashboard-card:hover .dashboard-card__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 576px) {
    .dashboard-card__icon {
      width: 40px;
      height: 40px;
    }

    .dashboard-card__title {
      font-size: 1rem;
    }

    .dashboard-card__description {
      font-size: 0.8rem;
    }
  }
</style>
