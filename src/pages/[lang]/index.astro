---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import icons from '@components/icons';
import { getLanguages, loadT } from '@lib/i18n';
import { idiomaR } from '@lib/routes';
import config from '../../../config.json';

export async function getStaticPaths() {
  return getLanguages().filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const t = loadT(lang);
const langPrefix = idiomaR(t);

const landingHTML = (t.index?.landing?.text ?? '').replace(/\*\*(.*?)\*\*/g, '<span class="text-primary">$1<\/span>');
const sistemas: Record<string, any> = t.posts?.sistemas ?? {};
---
<Layout t={t} route="/index" title={t.index?.name ?? 'Mini Kraken'}>
  <style>
    .bgImg2 {
      background: linear-gradient(var(--bs-dark) 0%, rgba(255,255,255,0)),
                  linear-gradient(rgba(255,255,255,0) 65%, var(--bs-dark) 100%),
                  url('/static/img/bg/dnd.webp') center / cover repeat-x;
    }
  </style>

  <!-- Hero -->
  <section id="inicio" style="background: url('/static/img/bg/pattern-square.svg') top / auto repeat-x;">
    <div class="container d-lg-flex align-items-lg-center py-4 py-xl-5">
      <div class="row gy-2 gy-md-0 row-cols-1 row-cols-lg-2 my-3 py-3">
        <div class="col-auto col-xl-6 text-center text-md-start d-flex d-sm-flex d-md-flex justify-content-center align-items-center justify-content-md-start align-items-md-center justify-content-xl-center">
          <div class="mb-5">
            <h1 class="display-1 fw-bold"><Fragment set:html={landingHTML} /></h1>
            <p class="text-secondary lead">{t.index?.start?.desc}</p>
            <a class="btn btn-primary btn-lg mt-1 border-2 px-5 me-1 generic_grow fw-bold" href={config.bot_invite} target="_blank">{t.nav?.add}</a>
            <a class="btn btn-primary btn-lg mt-1 border-2 px-4 generic_grow fw-bold" href={`${langPrefix}/tools`}>{t.online?.tools?.btn}</a>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6 d-md-flex justify-content-md-center align-items-md-center p-0 m-0">
          <img class="img-fluid generic_grow" alt="Mini Kraken RPG | Inanimalia Fortuna in Dungeon Background" width="600" height="400" src="/static/img/misc/blobs/place.webp" />
        </div>
      </div>
    </div>
  </section>

  <!-- Systems carousel -->
  <section class="py-3">
    <div class="container">
      <div class="mb-3">
        <h4 class="fw-semibold text-primary mb-0">{t.index?.system?.subtitle}</h4>
        <h1 class="display-5 fw-bold mt-0">{t.index?.system?.title}</h1>
        <p class="lead text-secondary -3">{t.index?.system?.desc}</p>
      </div>
      <div class="position-relative">
        <div class="top-0 start-auto end-0 gap-2 text-end">
          <button class="btn btn-primary" id="prev-btn" aria-label="Previous">&#x2039;</button>
          <button class="btn btn-primary" id="next-btn" aria-label="Next">&#x203A;</button>
        </div>
        <div class="d-inline-flex flex-row flex-grow-1 flex-fill py-3 px-2 overflow-scroll" id="auto-scroll" style="width: 100%;">
          {Object.keys(sistemas).map((key, idx) => {
            const s = sistemas[key];
            const url = `${langPrefix}/systems/${s.path}`;
            const showAuto = true; // manter badge ativo como no original por padrao
            return (
              <div class="col-9 col-sm-7 col-xl-3 col-xxl-3 d-flex me-3 system_card">
                <div class="card d-flex flex-grow-1 card_system_card border-1 position-relative">
                  {showAuto && (
                    <div class="bg-secondary-subtle border rounded-circle border-0 position-absolute end-0 mt-3 me-3" title="Suporte a Fichas &amp; Rolagem Automatica">
                      <svg class="text-secondary p-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor" style="font-size: 32px;"><path d="M176 24c0-13.3-10.7-24-24-24s-24 10.7-24 24V64c-35.3 0-64 28.7-64 64H24c-13.3 0-24 10.7-24 24s10.7 24 24 24H64v56H24c-13.3 0-24 10.7-24 24s10.7 24 24 24H64v56H24c-13.3 0-24 10.7-24 24s10.7 24 24 24H64c0 35.3 28.7 64 64 64v40c0 13.3 10.7 24 24 24s24-10.7 24-24V448h56v40c0 13.3 10.7 24 24 24s24-10.7 24-24V448h56v40c0 13.3 10.7 24 24 24s24-10.7 24-24V448c35.3 0 64-28.7 64-64h40c13.3 0 24-10.7 24-24s-10.7-24-24-24H448V280h40c13.3 0 24-10.7 24-24s-10.7-24-24-24H448V176h40c13.3 0 24-10.7 24-24s-10.7-24-24-24H448c0-35.3-28.7-64-64-64V24c0-13.3-10.7-24-24-24s-24 10.7-24 24V64H280V24c0-13.3-10.7-24-24-24s-24 10.7-24 24V64H176V24zM160 128H352c17.7 0 32 14.3 32 32V352c0 17.7-14.3 32-32 32H160c-17.7 0-32-14.3-32-32V160c0-17.7 14.3-32 32-32zm192 32H160V352H352V160z"/></svg>
                    </div>
                  )}
                  <div class="card-body d-flex flex-column py-2 px-3">
                    <a href={url} class="link-unstyled">
                      <div class="bs-icon-xl d-flex justify-content-center align-items-center d-inline-block mb-1 bs-icon">
                        <img class="img-fluid user-select-none" alt={`${s.card?.title} Icon`} src={s.icon} />
                      </div>
                      <h4 class="card-title user-select-none text-primary">{s.card?.title}</h4>
                    </a>
                    <p class="card-text user-select-none flex-grow-1">{s.card?.desc}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      <div class="text-end"><a class="mt-1 border-2 generic_grow fw-bold" href={`${langPrefix}/systems`}>{t.index?.allSystems?.text}</a></div>
    </div>
  </section>

  <!-- Dice section -->
  <section>
    <div class="container">
      <div class="row py-5">
        <div class="col-lg-6 col-xl-6 d-lg-flex align-items-lg-center">
          <div class="mb-5">
            <h4 class="fw-semibold text-primary mb-0">{t.index?.dices?.subtitle}</h4>
            <h1 class="display-5 fw-bold mt-0">{t.index?.dices?.title}</h1>
            <p class="lead text-secondary">{t.index?.dices?.desc}</p>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6">
          <img class="img-fluid generic_grow" width="600" height="400" alt="Mini Kraken Dice Roll Ilustration" src="/static/img/misc/blobs/dices.webp" />
        </div>
      </div>
    </div>
  </section>

  <!-- Sheets section -->
  <section>
    <div class="container">
      <div class="row py-5">
        <div class="col-lg-6 col-xl-6 d-lg-flex align-items-lg-center">
          <div class="mb-5">
            <h4 class="fw-semibold text-primary mb-0">{t.character?.sheet?.subtitle}</h4>
            <h1 class="display-5 fw-bold mt-0">{t.character?.sheet?.title}</h1>
            <p class="lead text-secondary">{t.character?.sheet?.desc}</p>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6">
          <img class="img-fluid p-4 generic_grow" width="600" height="400" alt="RPG Characters Sheets" src="/static/img/misc/blobs/sheets.webp" />
        </div>
      </div>
    </div>
  </section>

  <!-- Features cards -->
  <section class="bgImg2">
    <div class="container py-4 py-xl-5">
      <h2 class="text-light display-5 fw-bold mt-0">{t.index?.features?.title}</h2>
      <p class="lead text-secondary mt-1 mb-5">{t.index?.features?.desc}</p>
      <div class="row gy-4 row-cols-1 row-cols-md-2 row-cols-xl-3 d-flex">
        <!-- Card 0 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor"><path d="M228.3 469.1L47.6 300.4c-4.2-3.9-8.2-8.1-11.9-12.4h87c22.6 0 43-13.6 51.7-34.5l10.5-25.2 49.3 109.5c3.8 8.5 12.1 14 21.4 14.1s17.8-5 22-13.3L320 253.7l1.7 3.4c9.5 19 28.9 31 50.1 31H476.3c-3.7 4.3-7.7 8.5-11.9 12.4L283.7 469.1c-7.5 7-17.4 10.9-27.7 10.9s-20.2-3.9-27.7-10.9zM503.7 240h-132c-3 0-5.8-1.7-7.2-4.4l-23.2-46.3c-4.1-8.1-12.4-13.3-21.5-13.3s-17.4 5.1-21.5 13.3l-41.4 82.8L205.9 158.2c-3.9-8.7-12.7-14.3-22.2-14.1s-18.1 5.9-21.8 14.8l-31.8 76.3c-1.2 3-4.2 4.9-7.4 4.9H16c-2.6 0-5 .4-7.3 1.1C3 225.2 0 208.2 0 190.9v-5.8c0-69.9 50.5-129.5 119.4-141C165 36.5 211.4 51.4 244 84l12 12 12-12c32.6-32.6 79-47.5 124.6-39.9C461.5 55.6 512 115.2 512 185.1v5.8c0 16.9-2.8 33.5-8.3 49.1z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[0]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[0]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 1 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor"><path d="M48.7 125.8l53.2 31.9c7.8 4.7 17.8 2 22.2-5.9L201.6 12.1c3-5.4-.9-12.1-7.1-12.1c-1.6 0-3.2 .5-4.6 1.4L47.9 98.8c-9.6 6.6-9.2 20.9 .8 26.9zM16 171.7V295.3c0 8 10.4 11 14.7 4.4l60-92c5-7.6 2.6-17.8-5.2-22.5L40.2 158C29.6 151.6 16 159.3 16 171.7zM310.4 12.1l77.6 139.6c4.4 7.9 14.5 10.6 22.2 5.9l53.2-31.9c10-6 10.4-20.3 .8-26.9L322.1 1.4c-1.4-.9-3-1.4-4.6-1.4c-6.2 0-10.1 6.7-7.1 12.1zM496 171.7c0-12.4-13.6-20.1-24.2-13.7l-45.3 27.2c-7.8 4.7-10.1 14.9-5.2 22.5l60 92c4.3 6.7 14.7 3.6 14.7-4.4V171.7zm-49.3 246L286.1 436.6c-8.1 .9-14.1 7.8-14.1 15.9v52.8c0 3.7 3 6.8 6.8 6.8c.8 0 1.6-.1 2.4-.4l172.7-64c6.1-2.2 10.1-8 10.1-14.5c0-9.3-8.1-16.5-17.3-15.4zM233.2 512c3.7 0 6.8-3 6.8-6.8V452.6c0-8.1-6.1-14.9-14.1-15.9l-160.6-19c-9.2-1.1-17.3 6.1-17.3 15.4c0 6.5 4 12.3 10.1 14.5l172.7 64c.8 .3 1.6 .4 2.4 .4zM41.7 382.9l170.9 20.2c7.8 .9 13.4-7.5 9.5-14.3l-85.7-150c-5.9-10.4-20.7-10.8-27.3-.8L30.2 358.2c-6.5 9.9-.3 23.3 11.5 24.7zm439.6-24.8L402.9 238.1c-6.5-10-21.4-9.6-27.3 .8L290.2 388.5c-3.9 6.8 1.6 15.2 9.5 14.3l170.1-20c11.8-1.4 18-14.7 11.5-24.6zm-216.9 11l78.4-137.2c6.1-10.7-1.6-23.9-13.9-23.9H183.1c-12.3 0-20 13.3-13.9 23.9l78.4 137.2c3.7 6.4 13 6.4 16.7 0zM174.4 176H337.6c12.2 0 19.9-13.1 14-23.8l-80-144c-2.8-5.1-8.2-8.2-14-8.2h-3.2c-5.8 0-11.2 3.2-14 8.2l-80 144c-5.9 10.7 1.8 23.8 14 23.8z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[1]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[1]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="-64 0 512 512" width="1em" height="1em" fill="currentColor"><path d="M280 64h40c35.3 0 64 28.7 64 64V448c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V128C0 92.7 28.7 64 64 64h40 9.6C121 27.5 153.3 0 192 0s71 27.5 78.4 64H280zM64 112c-8.8 0-16 7.2-16 16V448c0 8.8 7.2 16 16 16H320c8.8 0 16-7.2 16-16V128c0-8.8-7.2-16-16-16H304v24c0 13.3-10.7 24-24 24H192 104c-13.3 0-24-10.7-24-24V112H64zm128-8a24 24 0 1 0 0-48 24 24 0 1 0 0 48z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[2]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[2]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor">
                      <path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z"/>
                    </svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[3]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[3]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="1em" height="1em" fill="currentColor"><path d="M96 0C60.7 0 32 28.7 32 64s28.7 64 64 64s64-28.7 64-64S131.3 0 96 0zM208 96c0-10.1-1.8-19.8-5.1-28.8C224 75.5 240 102.8 240 134.8v130.7C220.9 281.7 199.4 272 176 272c-26.5 0-48 21.5-48 48c0 1.9 .1 3.7 .3 5.5c-20.6-7.1-35.7-26.6-36.3-49.8l-1.7-64l-17.7 35.5c-10 20-28.3 34.5-50.1 39.5L3.2 293.3C1.1 294.3 0 296.5 0 298.8V464c0 26.5 21.5 48 48 48H400c26.5 0 48-21.5 48-48V176 160c0-17.7-14.3-32-32-32H208v-32zM496 160H352v32H496c8.8 0 16 7.2 16 16V448c0 35.3-28.7 64-64 64H416 384 368c-8.8 0-16-7.2-16-16V208c0-26.5 21.5-48 48-48h96z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[4]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[4]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 5 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor"><path d="M256 0C132.3 0 32 100.3 32 224S132.3 448 256 448s224-100.3 224-224S379.7 0 256 0zM96 224c0-88.4 71.6-160 160-160s160 71.6 160 160s-71.6 160-160 160S96 312.4 96 224z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[5]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[5]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 6 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="1em" height="1em" fill="currentColor"><path d="M0 96C0 60.7 28.7 32 64 32H192c35.3 0 64 28.7 64 64V160H448c35.3 0 64 28.7 64 64v96c0 35.3-28.7 64-64 64H320V416c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V96zM320 320H448V224H320v96zM64 96v320H256V96H64z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[6]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[6]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 7 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="1em" height="1em" fill="currentColor"><path d="M400 32H48C21.5 32 0 53.5 0 80V432c0 26.5 21.5 48 48 48H400c26.5 0 48-21.5 48-48V80c0-26.5-21.5-48-48-48zM368 96V224H80V96H368zM80 416V256H368V416H80z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[7]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[7]?.desc}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 8 -->
        <div class="col d-flex mt-1 mb-3">
          <div class="card border-white border-0 shadow glass-container cardBonito">
            <div class="card-body p-4">
              <div>
                <div class="d-flex justify-content-center align-items-center align-content-center">
                  <div class="bs-icon-md bs-icon-circle d-flex justify-content-center align-items-center d-inline-block bs-icon">
                    <svg class="text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" width="1em" height="1em" fill="currentColor"><path d="M96 96C96 78.3 110.3 64 128 64H192 512c17.7 0 32 14.3 32 32V384c0 17.7-14.3 32-32 32H192 128c-17.7 0-32-14.3-32-32V96zM128 384H192V128H128V384z"/></svg>
                  </div>
                </div>
                <h3 class="text-center text-white card-title">{t.index?.func?.card?.[8]?.title}</h3>
                <p class="text-start text-light card-text">{t.index?.func?.card?.[8]?.desc}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VTT section -->
  <section>
    <div class="container">
      <div class="row py-5">
        <div class="col-lg-6 col-xl-6 d-lg-flex align-items-lg-center">
          <div class="mb-5">
            <h1 class="display-5 fw-bold mt-0">{t.vtt?.index?.title}</h1>
            <p class="lead text-secondary">{t.vtt?.index?.desc}</p>
          </div>
        </div>
        <div class="col-lg-6 col-xl-6 mb-5">
          <img class="img-fluid generic_grow" width="600" height="400" alt="Mini Kraken VTT Ilustration" src="/static/img/misc/blobs/vtt2.webp" />
        </div>
      </div>
    </div>
  </section>

  <!-- Premium plans + modal -->
  <section id="premium" class="d-xl-flex justify-content-xl-center">
    <div class="container">
