---
export const prerender = true;
import { getLocale } from "astro-i18n-aut";
import Layout from '@layouts/Layout.astro';
import ToolCard from '@components/ToolCard.astro';
import { idiomaR } from '@lib/routes';
import { loadT, getStaticPaths } from '@lib/i18n';
import { Dices, Heart, Eye, Sprout, CircleDollarSign, CloudRain } from '@lucide/astro';

export { getStaticPaths };

const currentLocale = getLocale(Astro.url);
const t = loadT(currentLocale);
const path = idiomaR(t);
---
<Layout t={t} route="/tools" title={t.tools?.section?.title} desc={t.tools?.section?.desc}>
  <section id="inicio" style="background: url('pattern-square.svg') top / auto repeat-x;">
    <div class="container py-3">
      <div>
        <h1 class="display-5 fw-bold text-white">{t.tools?.section?.title}</h1>
        <p class="lead text-secondary">{t.tools?.section?.desc}</p>
      </div>
    </div>
    <div class="container py-4">
      <div class="row gy-4 row-cols-1 row-cols-md-2 row-cols-xl-3 flex grow">
        <ToolCard 
          href={`${path}/dices/`}
          title={t.nav?.dices?.title}
          description={t.nav?.dices?.desc}
          icon={Dices}
        />

        <ToolCard 
          href={`${path}/tools/poker/`}
          title={t.nav?.tools?.poker?.name}
          description={t.nav?.tools?.poker?.desc}
          icon={Heart}
        />

        <ToolCard 
          href={`${path}/tools/tarot/`}
          title={t.nav?.tools?.tarot?.name}
          description={t.nav?.tools?.tarot?.desc}
          icon={Eye}
        />

        <ToolCard 
          href={`${path}/tools/names/`}
          title={t.nav?.tools?.names?.title}
          description={t.nav?.tools?.names?.desc}
          icon={Sprout}
        />

        <ToolCard 
          href={`${path}/tools/coinflip/`}
          title={t.flip_coin?.title}
          description={t.flip_coin?.description}
          icon={CircleDollarSign}
        />

        <ToolCard 
          href={`${path}/tools/weather/`}
          title={t.tools?.clima?.pageTitle}
          description={t.tools?.clima?.pageDesc}
          icon={CloudRain}
        />
      </div>
    </div>
  </section>
</Layout>
